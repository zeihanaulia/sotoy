vaultName":"vault"},"type":"backlink","position":{"start":{"line":105,"column":3,"offset":4609},"end":{"line":105,"column":66,"offset":4672},"indent":[]},"value":"notes.security.pii-agent-architecture.camp.per-turn-masking"},{"from":{"fname":"notes.security.pii-agent-architecture.camp.indexed-masking","id":"notes.security.pii-agent-architecture.camp.indexed-masking","vaultName":"vault"},"type":"backlink","position":{"start":{"line":193,"column":3,"offset":7450},"end":{"line":193,"column":66,"offset":7513},"indent":[]},"value":"notes.security.pii-agent-architecture.camp.per-turn-masking"},{"from":{"fname":"notes.security.pii-agent-architecture.camp.why-camp","id":"notes.security.pii-agent-architecture.camp.why-camp","vaultName":"vault"},"type":"backlink","position":{"start":{"line":78,"column":3,"offset":3815},"end":{"line":78,"column":66,"offset":3878},"indent":[]},"value":"notes.security.pii-agent-architecture.camp.per-turn-masking"}],"anchors":{"inti-masalah":{"type":"header","text":"Inti masalah","value":"inti-masalah","line":16,"column":0,"depth":2},"contoh-klasikal":{"type":"header","text":"Contoh klasikal","value":"contoh-klasikal","line":21,"column":0,"depth":2},"kenapa-ini-salah-unit-analisis":{"type":"header","text":"Kenapa ini salah unit analisis","value":"kenapa-ini-salah-unit-analisis","line":31,"column":0,"depth":2},"dampak-praktis":{"type":"header","text":"Dampak praktis","value":"dampak-praktis","line":40,"column":0,"depth":2},"relevansi-ke-desain-security-agent":{"type":"header","text":"Relevansi ke desain security agent","value":"relevansi-ke-desain-security-agent","line":45,"column":0,"depth":2},"related-notes":{"type":"header","text":"Related notes","value":"related-notes","line":53,"column":0,"depth":2}},"children":[],"parent":"notes.security.pii-agent-architecture.camp","data":{}},"body":"<h1 id=\"per-turn-masking-gagal-untuk-agentic-multi-turn-chat\">Per-turn masking gagal untuk agentic multi-turn chat<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#per-turn-masking-gagal-untuk-agentic-multi-turn-chat\"></a></h1>\n<h2 id=\"inti-masalah\">Inti masalah<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#inti-masalah\"></a></h2>\n<p>Per-turn masking hanya menilai privacy risk pada satu pesan di satu waktu. Kalau agent mengirim ulang seluruh conversation history ke model setiap turn, solusi ini melewatkan risiko yang terbentuk dari akumulasi fragmen PII.</p>\n<p>Dalam agentic multi-turn chat, data lama bukan benar-benar \"lalu\". Itu bagian dari prompt yang dikirim ulang dan menjadi bahan inferensi model.</p>\n<h2 id=\"contoh-klasikal\">Contoh klasikal<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#contoh-klasikal\"></a></h2>\n<ul>\n<li>Turn 1: \"Gue lagi cari saran financial planning.\"</li>\n<li>Turn 2: \"Nama gue Raka.\"</li>\n<li>Turn 3: \"Gue tinggal di BSD.\"</li>\n<li>Turn 4: \"Gue kerja di Gojek.\"</li>\n<li>Turn 5: \"Gaji gue 35 juta.\"</li>\n</ul>\n<p>Per-turn masking bisa saja membersihkan setiap pesan secara individu.\nNamun jika history ini dipakai lagi pada turn 6, kombinasi Raka + BSD + Gojek + salary membuat profil yang lebih sensitif daripada setiap pesan tunggal.</p>\n<h2 id=\"kenapa-ini-salah-unit-analisis\">Kenapa ini salah unit analisis<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#kenapa-ini-salah-unit-analisis\"></a></h2>\n<p>Per-turn masking memodelkan privacy risk sebagai properti dari message.</p>\n<p>Tapi dalam agentic conversation, privacy risk adalah properti dari session yang mengandung banyak message.</p>\n<p>Perbedaannya:</p>\n<ul>\n<li>Message-level: \"Apakah pesan ini mengandung entitas sensitif?\"</li>\n<li>Session-level: \"Apakah kombinasi informasi yang terkumpul sampai sekarang sudah cukup untuk mengidentifikasi pengguna?\"</li>\n</ul>\n<h2 id=\"dampak-praktis\">Dampak praktis<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#dampak-praktis\"></a></h2>\n<ul>\n<li>Agent memory atau retrieval history membuat per-turn masking semakin berbahaya.</li>\n<li>Tool use dan handoff antar sub-agent memperbesar exposure karena history lama bisa tersebar ke lebih banyak channel.</li>\n<li>Stateless filter bisa saja benar untuk satu pesan, tetapi tetap salah secara keseluruhan jika history terus diteruskan.</li>\n</ul>\n<h2 id=\"relevansi-ke-desain-security-agent\">Relevansi ke desain security agent<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#relevansi-ke-desain-security-agent\"></a></h2>\n<p>Desain agent privacy harus memikirkan state session dan cumulative exposure.</p>\n<p>Ini berarti:</p>\n<ul>\n<li>menyimpan registry PII lintas turn,</li>\n<li>menghitung risiko dari kombinasi entitas,</li>\n<li>memutuskan apakah history lama perlu ditulis ulang atau dipseudonymize.</li>\n</ul>\n<h2 id=\"related-notes\">Related notes<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#related-notes\"></a></h2>\n<ul>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.camp\">CAMP: Cross-Turn PII Protection for LLM Conversations</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture\">Arsitektur PII filter dan security agent</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">notes (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">security (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">pii (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">agent (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">memory (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture\">Arsitektur PII filter dan security agent</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.agent-boundary-pii-filtering\">PII guardrail antar-agent: dari x402 ke brainstorming + coding agent</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.camp\">CAMP: Cross-Turn PII Protection for LLM Conversations</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.camp.cpe\">CPE: mengukur risiko PII sebagai akumulasi session, bukan message</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.camp.indexed-masking\">Indexed masking untuk agentic PII protection</a></li>\n<li><a href=\"/sotoy/notes/notes.security.pii-agent-architecture.camp.why-camp\">CAMP: apa yang baru dari solusi session-aware PII middleware</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegra