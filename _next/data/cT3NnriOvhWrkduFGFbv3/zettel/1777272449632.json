"line":25,"column":3,"offset":1281},"end":{"line":25,"column":51,"offset":1329},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.literature.the-developers-guide-to-ai"}},{"type":"wiki","from":{"fname":"zettel.1777272449632","id":"zettel.1777272449632","vaultName":"vault"},"value":"book-summaries.the-developers-guide-to-ai","position":{"start":{"line":26,"column":3,"offset":1332},"end":{"line":26,"column":48,"offset":1377},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"book-summaries.the-developers-guide-to-ai"}},{"from":{"fname":"zettel.moc.the-developers-guide-to-ai","id":"zettel.moc.the-developers-guide-to-ai","vaultName":"vault"},"type":"backlink","position":{"start":{"line":5,"column":3,"offset":128},"end":{"line":5,"column":27,"offset":152},"indent":[]},"value":"zettel.1777272449632"}],"anchors":{"ide-inti":{"type":"header","text":"Ide inti","value":"ide-inti","line":17,"column":0,"depth":2},"supporting-quotes":{"type":"header","text":"Supporting quotes","value":"supporting-quotes","line":21,"column":0,"depth":2},"kenapa-ini-penting":{"type":"header","text":"Kenapa ini penting","value":"kenapa-ini-penting","line":29,"column":0,"depth":2},"implikasi":{"type":"header","text":"Implikasi","value":"implikasi","line":33,"column":0,"depth":2},"sumber":{"type":"header","text":"Sumber","value":"sumber","line":37,"column":0,"depth":2}},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"api-dan-sdk-membuat-ai-jadi-komponen-software-bukan-domain-riset-terpisah\">API dan SDK membuat AI jadi komponen software, bukan domain riset terpisah<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#api-dan-sdk-membuat-ai-jadi-komponen-software-bukan-domain-riset-terpisah\"></a></h1>\n<h2 id=\"ide-inti\">Ide inti<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#ide-inti\"></a></h2>\n<p>Momen paling penting di sini bukan sekadar menemukan API dan SDK. Yang nyantol buat gue adalah saat AI berhenti terasa seperti disiplin riset berat dan mulai terlihat sebagai komponen software biasa yang bisa dihubungkan dengan database, UI, dan logic aplikasi.</p>\n<h2 id=\"supporting-quotes\">Supporting quotes<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#supporting-quotes\"></a></h2>\n<blockquote>\n<p>“I found a glimmer of hope: application programming interfaces (APIs) and software development kits (SDKs).”</p>\n</blockquote>\n<blockquote>\n<p>“This led me to solutions that researchers and startups were using to combine pretrained AI models with their own data—without training!”</p>\n</blockquote>\n<blockquote>\n<p>“I could combine these APIs with database and search techniques to build truly intelligent systems.”</p>\n</blockquote>\n<h2 id=\"kenapa-ini-penting\">Kenapa ini penting<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#kenapa-ini-penting\"></a></h2>\n<p>Konteks sebelum quote itu adalah rasa terintimidasi: AI terasa penuh statistik, linear algebra, dan training model. Titik baliknya bukan karena dia tiba-tiba paham teori, tapi karena dia menemukan interface yang familiar untuk developer. Itu mengubah problem dari \"harus jadi AI researcher\" menjadi \"bagaimana gue integrasikan AI ke sistem yang gue bangun\".</p>\n<h2 id=\"implikasi\">Implikasi<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#implikasi\"></a></h2>\n<p>Ini bukan hanya soal tool. Ini soal mental model: API/SDK menurunkan barrier masuk ke AI dengan mengubahnya menjadi komponen yang bisa digabungkan dengan pola software engineering yang sudah ada.</p>\n<h2 id=\"sumber\">Sumber<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#sumber\"></a></h2>\n<ul>\n<li>Part I / Preface</li>\n<li><a href=\"/sotoy/notes/zettel.literature.the-developers-guide-to-ai\">The Developer's Guide to AI sebagai literature note</a></li>\n<li><a href=\"/sotoy/notes/book-summaries.the-developers-guide-to-ai\">The Developer's Guide to AI</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">developer (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">integration (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">the-developers-guide-to-ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">part-i (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.moc.the-developers-guide-to-ai\">MOC The Developer's Guide to AI</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m",