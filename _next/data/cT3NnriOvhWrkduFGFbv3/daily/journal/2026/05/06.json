olumn":41,"offset":627},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.1778001021442"}},{"type":"wiki","from":{"fname":"daily.journal.2026.05.06","id":"daily.journal.2026.05.06","vaultName":"vault"},"value":"notes.agentic-engineering.reference.karpathy-software-is-changing-again","position":{"start":{"line":20,"column":34,"offset":1158},"end":{"line":20,"column":109,"offset":1233},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.reference.karpathy-software-is-changing-again"}}],"anchors":{"hari-ini-gue-perbarui-referensi-karpathy-untuk-agentic-engineering":{"type":"header","text":"Hari ini gue perbarui referensi Karpathy untuk agentic engineering","value":"hari-ini-gue-perbarui-referensi-karpathy-untuk-agentic-engineering","line":17,"column":0,"depth":2},"konteks":{"type":"header","text":"Konteks","value":"konteks","line":19,"column":0,"depth":3},"apa-yang-gue-kerjain":{"type":"header","text":"Apa yang gue kerjain","value":"apa-yang-gue-kerjain","line":23,"column":0,"depth":3},"insight-singkat":{"type":"header","text":"Insight singkat","value":"insight-singkat","line":28,"column":0,"depth":3},"next-step":{"type":"header","text":"Next step","value":"next-step","line":34,"column":0,"depth":3}},"children":[],"parent":"djv9ke3ors7sus2owix77ax","data":{}},"body":"<h1 id=\"2026-05-06\">2026-05-06<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#2026-05-06\"></a></h1>\n<h2 id=\"hari-ini-gue-perbarui-referensi-karpathy-untuk-agentic-engineering\">Hari ini gue perbarui referensi Karpathy untuk agentic engineering<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#hari-ini-gue-perbarui-referensi-karpathy-untuk-agentic-engineering\"></a></h2>\n<h3 id=\"konteks\">Konteks<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#konteks\"></a></h3>\n<ul>\n<li>fokus ke talk Andrej Karpathy \"Software Is Changing (Again)\".</li>\n<li>tujuan: dukung ide zettel tentang small incremental chunks, tight leash, verification loop, dan partial autonomy.</li>\n</ul>\n<h3 id=\"apa-yang-gue-kerjain\">Apa yang gue kerjain<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#apa-yang-gue-kerjain\"></a></h3>\n<ul>\n<li>update note <a href=\"/sotoy/notes/notes.agentic-engineering.cloud-agent.handson.reference.karpathy-keep-ai-on-the-leash\">Karpathy: Keep AI on the Leash</a> supaya langsung merujuk ke talk YC dan sumber non-paywall.</li>\n<li>tambahin timestamp penting dan framing istilah: leash, small incremental chunks, generation-verification loop, partial autonomy.</li>\n<li>sinkronkan <a href=\"/sotoy/notes/zettel.1778001021442\">Agentic engineering differs from vibe coding</a> supaya ada dukungan Karpathy yang lebih tepat dari talk asli.</li>\n</ul>\n<h3 id=\"insight-singkat\">Insight singkat<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#insight-singkat\"></a></h3>\n<ul>\n<li>Karpathy menegaskan: AI boleh generate cepat, tapi manusia tetap bottleneck untuk correctness, security, dan intent.</li>\n<li>prinsipnya bukan \"AI off\" vs \"AI bebas\", melainkan autonomy slider yang disesuaikan dengan kompleksitas dan risiko tugas.</li>\n<li>output AI besar bisa jadi bahaya, karena verifikasi manusia masih perlu berjalan.</li>\n<li>perubahan kecil bukan sekadar size, tapi unit yang bisa diverifikasi.</li>\n</ul>\n<h3 id=\"next-step\">Next step<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#next-step\"></a></h3>\n<ul>\n<li>pertimbangkan buat note khusus <a href=\"/sotoy/notes/notes.agentic-engineering.reference.karpathy-software-is-changing-again\">Karpathy — Software Is Changing (Again)</a> agar talk ini punya landing page sendiri.</li>\n<li>bisa juga tambahkan note pada cluster review agentic engineering untuk perbandingan antar reference notes.</li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">daily (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">agentic-engineering (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">karpathy (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai-coding (Private)</a></li>\n</ol>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefinition":false,"enableXVaultWikiLink":false,"enableRemoteVaultInit":true,"enableUserTags":true,"enableHashTags":true,"workspaceVaultSyncMode":"noCommit","enableAutoFoldFrontmatter":false,"enableEditorDecorations":true,"maxPreviewsCached":10,"maxNoteLength":204800,"seeds":{"den