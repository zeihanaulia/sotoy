14,"column":73,"offset":901},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101200","id":"zettel.20260507101200","vaultName":"vault"},"value":"zettel.20260507100500","position":{"start":{"line":15,"column":3,"offset":904},"end":{"line":15,"column":28,"offset":929},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.20260507100500"}},{"type":"wiki","from":{"fname":"zettel.20260507101200","id":"zettel.20260507101200","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":16,"column":3,"offset":932},"end":{"line":16,"column":37,"offset":966},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101200","id":"zettel.20260507101200","vaultName":"vault"},"value":"notes.agentic-engineering.single-verification-entrypoint","position":{"start":{"line":17,"column":3,"offset":969},"end":{"line":17,"column":63,"offset":1029},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.single-verification-entrypoint"}},{"from":{"fname":"zettel.moc.agentic-engineering","id":"zettel.moc.agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":57,"column":3,"offset":3615},"end":{"line":57,"column":28,"offset":3640},"indent":[]},"value":"zettel.20260507101200"}],"anchors":{},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"largest-ai-opportunities-are-new-work-formats-not-faster-old-workflows\">Largest AI opportunities are new work formats, not faster old workflows<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#largest-ai-opportunities-are-new-work-formats-not-faster-old-workflows\"></a></h1>\n<p>Claim: Peluang AI terbesar terletak pada format kerja baru yang sebelumnya tidak feasible, bukan hanya pada mempercepat workflow lama.</p>\n<p>Evidence:</p>\n<ul>\n<li>Karpathy: \"not only what can we do that existed that is faster now,\" tetapi juga cari \"things that couldn't be possible before.\"</li>\n<li>Contoh LLM knowledge base: dokumen direcompile, direorder, dan direframe menjadi knowledge base baru yang tidak mudah dibuat dengan kode tradisional karena beroperasi di atas dokumen semi-terstruktur.</li>\n</ul>\n<p>Why it matters:</p>\n<ul>\n<li>Mengalihkan mindset product dari optimasi incremental ke eksplorasi problem space baru.</li>\n<li>Menjelaskan bahwa kompetisi AI yang paling berharga bukan selalu di domain labor-intensive lama, melainkan di domain yang membuka jenis pekerjaan baru.</li>\n</ul>\n<p>See also:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering\">Andrej Karpathy: From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering\">Karpathy — From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507100500\">Operational docs are turning into agent-executable artifacts</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.single-verification-entrypoint\">Single verification entrypoint</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">product (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">agentic-engineering (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n