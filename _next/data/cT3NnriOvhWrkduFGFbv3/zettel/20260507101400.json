umn":73,"offset":865},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101400","id":"zettel.20260507101400","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":15,"column":3,"offset":868},"end":{"line":15,"column":37,"offset":902},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101400","id":"zettel.20260507101400","vaultName":"vault"},"value":"notes.agentic-engineering.single-verification-entrypoint","position":{"start":{"line":16,"column":3,"offset":905},"end":{"line":16,"column":63,"offset":965},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.single-verification-entrypoint"}},{"from":{"fname":"zettel.20260507101500","id":"zettel.20260507101500","vaultName":"vault"},"type":"backlink","position":{"start":{"line":15,"column":3,"offset":779},"end":{"line":15,"column":28,"offset":804},"indent":[]},"value":"zettel.20260507101400"},{"from":{"fname":"zettel.20260507101700","id":"zettel.20260507101700","vaultName":"vault"},"type":"backlink","position":{"start":{"line":13,"column":3,"offset":550},"end":{"line":13,"column":28,"offset":575},"indent":[]},"value":"zettel.20260507101400"},{"from":{"fname":"zettel.20260507101900","id":"zettel.20260507101900","vaultName":"vault"},"type":"backlink","position":{"start":{"line":12,"column":3,"offset":570},"end":{"line":12,"column":28,"offset":595},"indent":[]},"value":"zettel.20260507101400"},{"from":{"fname":"zettel.moc.agentic-engineering","id":"zettel.moc.agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":59,"column":3,"offset":3825},"end":{"line":59,"column":28,"offset":3850},"indent":[]},"value":"zettel.20260507101400"}],"anchors":{},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"specification-fuels-classical-software-verification-fuels-agentic-ai\">Specification fuels classical software; verification fuels agentic AI<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#specification-fuels-classical-software-verification-fuels-agentic-ai\"></a></h1>\n<p>Claim: Spesifikasi adalah bahan bakar untuk software klasik, sedangkan verifikasi adalah bahan bakar untuk agentic AI seperti LLM yang dilatih dengan RL.</p>\n<p>Evidence:</p>\n<ul>\n<li>Karpathy: \"Traditional computers can easily automate what you can specify in code and this latest round of LLMs can easily automate what you can verify.\"</li>\n<li>Penjelasan bahwa LLM + RL membutuhkan reward/verifier, sehingga domain seperti code, math, test, benchmark, dan security challenge berkembang cepat.</li>\n</ul>\n<p>Why it matters:</p>\n<ul>\n<li>Menunjukkan perbedaan filosofis antara engineering klasik dan agentic AI.</li>\n<li>Memberi kerangka kerja untuk memilih masalah AI: apakah domainnya lebih cocok dengan spesifikasi eksplisit atau dengan sistem verifikasi.</li>\n</ul>\n<p>See also:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering\">Andrej Karpathy: From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering\">Karpathy — From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.single-verification-entrypoint\">Single verification entrypoint</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">verification (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">software (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.20260507101500\">LLM capability is a jagged map, not a smooth curve</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507101700\">Human-in-the-loop is a response to jagged AI, not nostalgia</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507101900\">Automation frontier is defined by evaluator cost, not just model capability</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefinition":false,"enableXVa