l-framework","vaultName":"vault"},"value":"notes.psychology.social-maturity-narcissism","position":{"start":{"line":39,"column":11,"offset":2376},"end":{"line":39,"column":58,"offset":2423},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.social-maturity-narcissism"}},{"type":"wiki","from":{"fname":"notes.psychology.biopsychosocial-cultural-spiritual-framework","id":"notes.psychology.biopsychosocial-cultural-spiritual-framework","vaultName":"vault"},"value":"notes.psychology.biological-social-pattern-fixing","position":{"start":{"line":39,"column":60,"offset":2425},"end":{"line":39,"column":113,"offset":2478},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.biological-social-pattern-fixing"}},{"from":{"fname":"handbook.growth.systemic-fixing-guide","id":"handbook.growth.systemic-fixing-guide","vaultName":"vault"},"type":"backlink","position":{"start":{"line":41,"column":11,"offset":2110},"end":{"line":41,"column":76,"offset":2175},"indent":[]},"value":"notes.psychology.biopsychosocial-cultural-spiritual-framework"},{"from":{"fname":"notes.psychology.layer-biological","id":"notes.psychology.layer-biological","vaultName":"vault"},"type":"backlink","position":{"start":{"line":21,"column":11,"offset":1256},"end":{"line":21,"column":76,"offset":1321},"indent":[]},"value":"notes.psychology.biopsychosocial-cultural-spiritual-framework"},{"from":{"fname":"notes.psychology.layer-psychological","id":"notes.psychology.layer-psychological","vaultName":"vault"},"type":"backlink","position":{"start":{"line":19,"column":11,"offset":1098},"end":{"line":19,"column":76,"offset":1163},"indent":[]},"value":"notes.psychology.biopsychosocial-cultural-spiritual-framework"},{"from":{"fname":"notes.psychology.layer-social-cultural","id":"notes.psychology.layer-social-cultural","vaultName":"vault"},"type":"backlink","position":{"start":{"line":20,"column":11,"offset":1100},"end":{"line":20,"column":76,"offset":1165},"indent":[]},"value":"notes.psychology.biopsychosocial-cultural-spiritual-framework"},{"from":{"fname":"notes.psychology.layer-spiritual","id":"notes.psychology.layer-spiritual","vaultName":"vault"},"type":"backlink","position":{"start":{"line":24,"column":11,"offset":1156},"end":{"line":24,"column":76,"offset":1221},"indent":[]},"value":"notes.psychology.biopsychosocial-cultural-spiritual-framework"}],"anchors":{"biopsychosocial-cultural-spiritual-framework":{"type":"header","text":"Biopsychosocial-Cultural-Spiritual Framework","value":"biopsychosocial-cultural-spiritual-framework","line":14,"column":0,"depth":1},"overview":{"type":"header","text":"Overview","value":"overview","line":16,"column":0,"depth":2},"the-five-layers-of-the-system":{"type":"header","text":"The Five Layers of the System","value":"the-five-layers-of-the-system","line":19,"column":0,"depth":2},"1-biological-biologi":{"type":"header","text":"1. Biological (Biologi)","value":"1-biological-biologi","line":21,"column":0,"depth":3},"2-psychological-psikologi":{"type":"header","text":"2. Psychological (Psikologi)","value":"2-psychological-psikologi","line":26,"column":0,"depth":3},"3-social-sosial":{"type":"header","text":"3. Social (Sosial)","value":"3-social-sosial","line":31,"column":0,"depth":3},"4-cultural-kultural":{"type":"header","text":"4. Cultural (Kultural)","value":"4-cultural-kultural","line":36,"column":0,"depth":3},"5-spiritual-spiritualvalue":{"type":"header","text":"5. Spiritual (Spiritual/Value)","value":"5-spiritual-spiritualvalue","line":41,"column":0,"depth":3},"synthesis-the-systemic-view":{"type":"header","text":"Synthesis: The Systemic View","value":"synthesis-the-systemic-view","line":46,"column":0,"depth":2}},"children":[],"parent":"k7whujrtxo2tvftwjvbq1jh","data":{}},"body":"<h1 id=\"biopsychosocial-cultural-spiritual-framework\">Biopsychosocial-Cultural-Spiritual Framework<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#biopsychosocial-cultural-spiritual-framework\"></a></h1>\n<h1 id=\"biopsychosocial-cultural-spiritual-framework-1\">Biopsychosocial-Cultural-Spiritual Framework<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#biopsychosocial-cultural-spiritual-framework-1\"></a></h1>\n<h2 id=\"overview\">Overview<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#overview\"></a></h2>\n<p>Kesehatan jiwa bukan sekadar masalah pikiran, melainkan hasil interaksi kompleks antara lima layer utama. Memperbaiki pola batin tidak bisa dilakukan hanya dari satu pintu; jika satu layer bocor, layer lainnya akan terasa lebih berat.</p>\n<h2 id=\"the-five-layers-of-the-system\">The Five Layers of the System<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#the-five-layers-of-the-system\"></a></h2>\n<h3 id=\"1-biological-biologi\">1. Biological (Biologi)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#1-biological-biologi\"></a></h3>\n<p>Otak adalah organ tubuh, bukan awan abstrak. Kondisi fisik menentukan kapasitas dasar sistem saraf untuk tidak reaktif.</p>\n<ul>\n<li><strong>Faktor Kunci</strong>: Gizi, kualitas tidur, aktivitas fisik, kesehatan lingkungan (polusi), dan pola hidup (sedentary behavior).</li>\n<li><strong>Dampak</strong>: Tubuh yang lelah, kurang gerak, atau <em>over-stimulated</em> (doomscrolling) membuat otak lebih mudah masuk mode defensif dan reaktif.</li>\n</ul>\n<h3 id=\"2-psychological-psikologi\">2. Psychological (Psikologi)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#2-psychological-psikologi\"></a></h3>\n<p>Berfokus pada template reaksi yang terbentuk dari pengalaman masa lalu.</p>\n<ul>\n<li><strong>Faktor Kunci</strong>: <em>Adverse Childhood Events</em> (ACEs), trauma yang belum diproses, dan mekanisme <em>coping</em>.</li>\n<li><strong>Dampak</strong>: Trauma yang tidak diproses menjadi template reaksi (misal: \"peduli = jebakan\").</li>\n</ul>\n<h3 id=\"3-social-sosial\">3. Social (Sosial)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#3-social-sosial\"></a></h3>\n<p>Lingkungan yang memberikan feedback terhadap perilaku kita.</p>\n<ul>\n<li><strong>Faktor Kunci</strong>: Kualitas pertemanan, dukungan sosial, dan kehadiran mentor/teman yang memberikan feedback sehat (bukan sekadar <em>toxic positivity</em>).</li>\n<li><strong>Dampak</strong>: Lingkungan yang hanya mengafirmasi luka akan mengunci individu dalam pola berulang.</li>\n</ul>\n<h3 id=\"4-cultural-kultural\">4. Cultural (Kultural)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#4-cultural-kultural\"></a></h3>\n<p>Software tak terlihat berupa norma, mitos, dan nilai budaya.</p>\n<ul>\n<li><strong>Faktor Kunci</strong>: Norma gender, ekspektasi keluarga, dan mitos budaya (misal: \"sabar\" yang digunakan untuk membenarkan eksploitasi).</li>\n<li><strong>Dampak</strong>: Budaya bisa membuat pola sakit terlihat normal atau membuat perilaku sehat terlihat memalukan.</li>\n</ul>\n<h3 id=\"5-spiritual-spiritualvalue\">5. Spiritual (Spiritual/Value)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#5-spiritual-spiritualvalue\"></a></h3>\n<p>Sistem nilai yang menjadi kompas dan rem saat ego mulai membenarkan diri.</p>\n<ul>\n<li><strong>Faktor Kunci</strong>: Nilai hidup, integritas, dan tujuan eksistensial.</li>\n<li><strong>Dampak</strong>: Value yang kabur membuat ego mudah melakukan rasionalisasi atas perilaku buruk.</li>\n</ul>\n<h2 id=\"synthesis-the-systemic-view\">Synthesis: The Systemic View<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#synthesis-the-systemic-view\"></a></h2>\n<p>Fixing diri adalah membangun ekosistem baru. Jika seseorang ingin memutus pola \"takut tampil\" atau \"dingin dalam relasi\", ia harus memeriksa kelima layer ini secara simultan.</p>\n<blockquote>\n<p><strong>Atomic Idea</strong>: Kita bukan sekadar label (misal: \"pemalu\" atau \"narsistik\"), melainkan sistem yang terdiri dari tubuh, luka, lingkungan, budaya, dan nilai.</p>\n</blockquote>\n<p>See also: <a href=\"/sotoy/notes/notes.psychology.social-maturity-narcissism\">Social Maturity and Narcissism Reduction</a>, <a href=\"/sotoy/notes/notes.psychology.biological-social-pattern-fixing\">Biological and Social Factors in Pattern Fixing</a></p>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">psychology (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">holistic-health (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">trauma-recovery (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">systemic-view (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/handbook.growth.systemic-fixing-guide\">Systemic Fixing Guide for Behavioral Patterns</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.layer-biological\">Biological Layer of Mental Health</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.layer-psychological\">Psychological Layer: Trauma and Templates</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.layer-social-cultural\">Social and Cultural Layers of Identity</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.layer-spiritual\">Spiritual Layer: Values as the Ego's Brake</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"inse