arness"},{"from":{"fname":"zettel.20260505179971","id":"zettel.20260505179971","vaultName":"vault"},"type":"backlink","position":{"start":{"line":7,"column":3,"offset":282},"end":{"line":7,"column":37,"offset":316},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"zettel.20260505179973","id":"zettel.20260505179973","vaultName":"vault"},"type":"backlink","position":{"start":{"line":6,"column":3,"offset":297},"end":{"line":6,"column":37,"offset":331},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"zettel.20260505179977","id":"zettel.20260505179977","vaultName":"vault"},"type":"backlink","position":{"start":{"line":5,"column":3,"offset":208},"end":{"line":5,"column":37,"offset":242},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"zettel.20260505179981","id":"zettel.20260505179981","vaultName":"vault"},"type":"backlink","position":{"start":{"line":6,"column":3,"offset":261},"end":{"line":6,"column":37,"offset":295},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"zettel.20260505179982","id":"zettel.20260505179982","vaultName":"vault"},"type":"backlink","position":{"start":{"line":5,"column":3,"offset":195},"end":{"line":5,"column":37,"offset":229},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"type":"backlink","position":{"start":{"line":70,"column":3,"offset":3955},"end":{"line":70,"column":37,"offset":3989},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"notes.security.overtrust-evaluation","id":"notes.security.overtrust-evaluation","vaultName":"vault"},"type":"backlink","position":{"start":{"line":150,"column":3,"offset":9994},"end":{"line":150,"column":37,"offset":10028},"indent":[]},"value":"notes.security.deepsec-harness"},{"from":{"fname":"notes.security.overtrust.workflow-detail","id":"notes.security.overtrust.workflow-detail","vaultName":"vault"},"type":"backlink","position":{"start":{"line":198,"column":3,"offset":7938},"end":{"line":198,"column":37,"offset":7972},"indent":[]},"value":"notes.security.deepsec-harness"}],"anchors":{"overview":{"type":"header","text":"Overview","value":"overview","line":15,"column":0,"depth":2},"masalah-fundamental-yang-diselesaikan-deepsec":{"type":"header","text":"Masalah fundamental yang diselesaikan Deepsec","value":"masalah-fundamental-yang-diselesaikan-deepsec","line":18,"column":0,"depth":2},"apa-itu-security-harness":{"type":"header","text":"Apa itu \"security harness\"?","value":"apa-itu-security-harness","line":25,"column":0,"depth":2},"workflow-deepsec":{"type":"header","text":"Workflow Deepsec","value":"workflow-deepsec","line":31,"column":0,"depth":2},"1-scan":{"type":"header","text":"1. Scan","value":"1-scan","line":32,"column":0,"depth":3},"2-investigate":{"type":"header","text":"2. Investigate","value":"2-investigate","line":37,"column":0,"depth":3},"3-revalidate":{"type":"header","text":"3. Revalidate","value":"3-revalidate","line":42,"column":0,"depth":3},"4-enrich":{"type":"header","text":"4. Enrich","value":"4-enrich","line":48,"column":0,"depth":3},"5-export":{"type":"header","text":"5. Export","value":"5-export","line":53,"column":0,"depth":3},"use-case-realistis":{"type":"header","text":"Use case realistis","value":"use-case-realistis","line":57,"column":0,"depth":2},"audit-repo-besar-sebelum-release":{"type":"header","text":"Audit repo besar sebelum release","value":"audit-repo-besar-sebelum-release","line":58,"column":0,"depth":3},"scheduled-audit-area-berisiko":{"type":"header","text":"Scheduled audit area berisiko","value":"scheduled-audit-area-berisiko","line":62,"column":0,"depth":3},"fokus-area-sensitif":{"type":"header","text":"Fokus area sensitif","value":"fokus-area-sensitif","line":66,"column":0,"depth":3},"custom-matcher":{"type":"header","text":"Custom matcher","value":"custom-matcher","line":70,"column":0,"depth":3},"maintainer-oss":{"type":"header","text":"Maintainer OSS","value":"maintainer-oss","line":74,"column":0,"depth":3},"batasan-dan-risiko":{"type":"header","text":"Batasan dan risiko","value":"batasan-dan-risiko","line":78,"column":0,"depth":2},"implementasi-sehat-buat-dunia-nyata":{"type":"header","text":"Implementasi sehat buat dunia nyata","value":"implementasi-sehat-buat-dunia-nyata","line":86,"column":0,"depth":2},"korelasi-konsep-lain":{"type":"header","text":"Korelasi konsep lain","value":"korelasi-konsep-lain","line":95,"column":0,"depth":2},"insight-penting":{"type":"header","text":"Insight penting","value":"insight-penting","line":101,"column":0,"depth":2},"referensi-terkait":{"type":"header","text":"Referensi terkait","value":"referensi-terkait","line":110,"column":0,"depth":2},"related-zettels":{"type":"header","text":"Related Zettels","value":"related-zettels","line":113,"column":0,"depth":2}},"children":[],"parent":"pzi0cboc61frvywcjrbk550","data":{}},"body":"<h1 id=\"deepsec-security-harness-untuk-codebase-besar\">Deepsec: security harness untuk codebase besar<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#deepsec-security-harness-untuk-codebase-besar\"></a></h1>\n<h2 id=\"overview\">Overview<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#overview\"></a></h2>\n<p>Gue sekarang nangkep Deepsec bukan sebagai scanner biasa. Menurut gue dia lebih kayak \"security harness\" yang ngatur agent, bukan cuma ngasih AI buat ngecek kode.</p>\n<h2 id=\"masalah-fundamental-yang-diselesaikan-deepsec\">Masalah fundamental yang diselesaikan Deepsec<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#masalah-fundamental-yang-diselesaikan-deepsec\"></a></h2>\n<ul>\n<li>repo modern terlalu besar buat direview manual.</li>\n<li>bug keamanan sering muncul dari relasi antar file, bukan pattern tunggal.</li>\n<li>scanner tradisional jago rule, tapi lemah kalau konteksnya kompleks.</li>\n<li>problem nyata biasanya ada di flow: auth, permission, webhook, server action, dan boundary data.</li>\n<li>Deepsec berusaha menemukan area sensitif dulu, kemudian ngerjain investigasi yang lebih dalam.</li>\n</ul>\n<h2 id=\"apa-itu-security-harness\">Apa itu \"security harness\"?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#apa-itu-security-harness\"></a></h2>\n<ul>\n<li>buat gue, harness itu sistem yang ngatur proses, bukan cuma model.</li>\n<li>dia merangkum: menentukan scope, ngejalain agent, validasi, ngasih severity, dan nempelkan owner.</li>\n<li>ini bedanya Deepsec sama scanner yang output-nya cuma \"ada issue\" tanpa bukti.</li>\n<li>kalau cuma scanner, outputnya mentah. kalau harness, outputnya mesti bisa ditindaklanjuti.</li>\n</ul>\n<h2 id=\"workflow-deepsec\">Workflow Deepsec<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#workflow-deepsec\"></a></h2>\n<h3 id=\"1-scan\">1. Scan<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#1-scan\"></a></h3>\n<ul>\n<li>Deepsec mulai dari regex-only scan ke seluruh file.</li>\n<li>menurut gue ini langkah bagus: LLM mahal, jadi pakai dulu cara murah untuk cari hotspot.</li>\n<li>ini mirip cara kerja security engineer: jangan baca semua file, cari yang berisiko dulu.</li>\n</ul>\n<h3 id=\"2-investigate\">2. Investigate<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#2-investigate\"></a></h3>\n<ul>\n<li>setelah kandidat ketemu, baru agent masuk.</li>\n<li>agent ini nggak cuma cari pattern. dia nonton flow, cek mitigasi, lihat reachable path, dan nilai impact.</li>\n<li>intinya: bukan sekadar \"ada input user\". yang penting adalah \"apakah kontrolnya cukup?\"</li>\n</ul>\n<h3 id=\"3-revalidate\">3. Revalidate<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#3-revalidate\"></a></h3>\n<ul>\n<li>ini yang penting buat gue.</li>\n<li>Deepsec nggak berhenti di satu pass. ada run kedua buat ngecek hasil pertama.</li>\n<li>revalidate berfungsi buat nurunin false positive dan ngoreksi severity.</li>\n<li>kalau agent cuma sekali, hasilnya sering overclaim.</li>\n</ul>\n<h3 id=\"4-enrich\">4. Enrich<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#4-enrich\"></a></h3>\n<ul>\n<li>Deepsec nggak cuma kasih issue, tapi coba nempelkan metadata dan owner.</li>\n<li>ini penting karena kalau issue nggak punya pemilik, dia bakal mati di dashboard.</li>\n<li>temuan security harus bisa ditangani engineering, bukan cuma dicatat.</li>\n</ul>\n<h3 id=\"5-export\">5. Export<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#5-export\"></a></h3>\n<ul>\n<li>hasilnya bisa diekspor jadi instruksi, ticket, atau prompt agent lain.</li>\n<li>menurut gue ini poin kritis: output harus bisa langsung dipakai, bukan cuma \"ada masalah\".</li>\n</ul>\n<h2 id=\"use-case-realistis\">Use case realistis<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#use-case-realistis\"></a></h2>\n<h3 id=\"audit-repo-besar-sebelum-release\">Audit repo besar sebelum release<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#audit-repo-besar-sebelum-release\"></a></h3>\n<ul>\n<li>Deepsec paling masuk akal buat app yang kompleks: multi-tenant, admin API, billing, webhook.</li>\n<li>nggak semua commit perlu diskip. lebih cocok sebelum major release atau audit domain berisiko.</li>\n</ul>\n<h3 id=\"scheduled-audit-area-berisiko\">Scheduled audit area berisiko<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#scheduled-audit-area-berisiko\"></a></h3>\n<ul>\n<li>menurut gue, lebih sehat jalankan berkala di repo penting.</li>\n<li>hasilnya masuk backlog security, lalu ditriage sebelum sprint.</li>\n</ul>\n<h3 id=\"fokus-area-sensitif\">Fokus area sensitif<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#fokus-area-sensitif\"></a></h3>\n<ul>\n<li>yang worth: auth/session, RBAC/ABAC, tenant isolation, payment, webhook, upload, fetch, secret management.</li>\n<li>ini bikin Deepsec nggak jadi \"satpam semua file\".</li>\n</ul>\n<h3 id=\"custom-matcher\">Custom matcher<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#custom-matcher\"></a></h3>\n<ul>\n<li>temuan awal nggak cukup. yang paling berguna adalah jika temuan itu jadi matcher baru.</li>\n<li>contoh: kalau satu endpoint admin ilang permission check, bikin matcher buat cari pola serupa.</li>\n</ul>\n<h3 id=\"maintainer-oss\">Maintainer OSS<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#maintainer-oss\"></a></h3>\n<ul>\n<li>Deepsec juga bisa bantu OSS maintainer yang butuh laporan actionable.</li>\n<li>tapi disclosure harus hati-hati.</li>\n</ul>\n<h2 id=\"batasan-dan-risiko\">Batasan dan risiko<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#batasan-dan-risiko\"></a></h2>\n<ul>\n<li>false positive masih ada.</li>\n<li>Deepsec bukan oracle. output tetap perlu triage manusia.</li>\n<li>kualitas sangat bergantung model, prompt, dan budget.</li>\n<li>biaya bisa besar kalau scan full repo tanpa prioritas.</li>\n<li>kalau codebase dieksekusi lewat cloud, kontrol source code masih penting.</li>\n<li>finding yang nggak actionable malah jadi beban.</li>\n</ul>\n<h2 id=\"implementasi-sehat-buat-dunia-nyata\">Implementasi sehat buat dunia nyata<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#implementasi-sehat-buat-dunia-nyata\"></a></h2>\n<ul>\n<li>jangan langsung scan semua repo.</li>\n<li>mulai dari satu repo penting dan satu domain risiko.</li>\n<li>bikin rubric triage: validitas, reachable, impact, auth/public, confidence.</li>\n<li>ekspor langsung ke ticket dengan owner dan bukti.</li>\n<li>buat custom matcher dari temuan valid.</li>\n<li>scan manual dulu sebelum release besar, baru scale.</li>\n<li>CI gate cuma di area tertentu jika SNR-nya sudah bagus.</li>\n</ul>\n<h2 id=\"korelasi-konsep-lain\">Korelasi konsep lain<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#korelasi-konsep-lain\"></a></h2>\n<ul>\n<li>SAST: Deepsec pakai rule awal, tapi nambah reasoning kontekstual.</li>\n<li>fuzzing: keduanya eksploratif. fuzzing punya oracle crash; Deepsec butuh verifikasi semantik.</li>\n<li>pentest: Deepsec agak mirip pola pikir pentester, tapi manusia masih lebih kuat di konteks bisnis dan exploit kompleks.</li>\n<li>Secure SDLC: Deepsec bisa jadi lapisan baru di antara SAST dan pentest manusia.</li>\n</ul>\n<h2 id=\"insight-penting\">Insight penting<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#insight-penting\"></a></h2>\n<ul>\n<li>Deepsec bukan cuma agent. dia sistem kerja.</li>\n<li>tanpa scan awal, agent keborosan.</li>\n<li>tanpa investigation, scan cuma pattern matcher.</li>\n<li>tanpa revalidate, output rentan noisy.</li>\n<li>tanpa enrich, temuan bisa hilang.</li>\n<li>tanpa export, hasil nggak masuk workflow.</li>\n<li>yang penting bukan \"pakai model apa\", tapi \"bagaimana temuan diverifikasi dan dikonversi jadi patch\".</li>\n</ul>\n<h2 id=\"referensi-terkait\">Referensi terkait<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#referensi-terkait\"></a></h2>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.20260505179908\">AI security review perlu harness dan triage, bukan hanya agent</a></li>\n</ul>\n<h2 id=\"related-zettels\">Related Zettels<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#related-zettels\"></a></h2>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.20260505179969\">Security harness lebih penting daripada single AI agent</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179970\">Revalidation dan ownership adalah kunci agar output agent tidak menjadi noise</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179973\">Parallel agents hanya berguna jika hasilnya didedup dan dikonsolidasikan</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179975\">Rule-based checks tetap penting di era AI-native security</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179977\">Custom matcher mengubah temuan menjadi aturan yang bisa dipakai ulang</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179979\">Biaya, sandbox, dan egress adalah concern arsitektur keamanan first-class</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179980\">Keamanan AI-native adalah kebiasaan harian, bukan event sekali jalan</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179981\">Finding keamanan butuh bukti yang actionable kapan pun bisa</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179982\">Ownership adalah bagian dari penyelesaian security finding</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179983\">Sandbox dan boundary adalah persyaratan untuk tool agentic aman</a></li>\n<li><a href=\"/sotoy/notes/daily.journal.2026.05.05\">2026-05-05</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">notes (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">security (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai-security (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">deepsec (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.20260505179967\">Agentic coding tools adalah process dengan permission, bukan autocomplete</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179969\">Security harness lebih penting daripada single AI agent</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179971\">Deterministic local scanners melengkapi AI scanners dalam keamanan developer workflow</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179973\">Parallel agents hanya berguna jika hasilnya didedup dan dikonsolidasikan</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179977\">Custom matcher mengubah temuan menjadi aturan yang bisa dipakai ulang</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179981\">Finding keamanan butuh bukti yang actionable kapan pun bisa</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260505179982\">Ownership adalah bagian dari penyelesaian security finding</a></li>\n<li><a href=\"/sotoy/notes/notes.security.deepsec-challenges\">Deepsec challenge: orchestration, false positives, cost, dan workflow</a></li>\n<li><a href=\"/sotoy/notes/notes.security.overtrust-evaluation\">Evaluasi Overtrust: konsep bagus tapi rule-based dan belum all-cover</a></li>\n<li><a href=\"/sotoy/notes/notes.security.overtrust.workflow-detail\">Overtrust workflow detail: cara kerja local scanner dan trust boundary</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefiniti