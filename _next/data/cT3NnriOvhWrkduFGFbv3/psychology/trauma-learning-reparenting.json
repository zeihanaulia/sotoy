hology.maladaptive-memory"}},{"type":"wiki","from":{"fname":"notes.psychology.trauma-learning-reparenting","id":"notes.psychology.trauma-learning-reparenting","vaultName":"vault"},"value":"notes.psychology.recurring-patterns-vs-incidents","position":{"start":{"line":23,"column":52,"offset":1230},"end":{"line":23,"column":104,"offset":1282},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.recurring-patterns-vs-incidents"}},{"from":{"fname":"notes.psychology.layer-psychological","id":"notes.psychology.layer-psychological","vaultName":"vault"},"type":"backlink","position":{"start":{"line":19,"column":78,"offset":1165},"end":{"line":19,"column":126,"offset":1213},"indent":[]},"value":"notes.psychology.trauma-learning-reparenting"}],"anchors":{"trauma-informed-learning-and-reparenting":{"type":"header","text":"Trauma-Informed Learning and Reparenting","value":"trauma-informed-learning-and-reparenting","line":16,"column":0,"depth":1},"trauma-as-a-reflex":{"type":"header","text":"Trauma as a Reflex","value":"trauma-as-a-reflex","line":18,"column":0,"depth":2},"the-reparenting-process":{"type":"header","text":"The Reparenting Process","value":"the-reparenting-process","line":21,"column":0,"depth":2},"post-traumatic-growth":{"type":"header","text":"Post-Traumatic Growth","value":"post-traumatic-growth","line":32,"column":0,"depth":2}},"children":[],"parent":"k7whujrtxo2tvftwjvbq1jh","data":{}},"body":"<h1 id=\"trauma-informed-learning-and-reparenting\">Trauma-Informed Learning and Reparenting<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#trauma-informed-learning-and-reparenting\"></a></h1>\n<h1 id=\"trauma-informed-learning-and-reparenting-1\">Trauma-Informed Learning and Reparenting<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#trauma-informed-learning-and-reparenting-1\"></a></h1>\n<h2 id=\"trauma-as-a-reflex\">Trauma as a Reflex<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#trauma-as-a-reflex\"></a></h2>\n<p>Trauma yang tidak diproses cenderung mengulang dirinya sebagai refleks. Jika seseorang belajar bahwa \"peduli itu bahaya\" atau \"tampil itu memalukan\", otak akan memproduksi respons defensif secara otomatis di masa depan.</p>\n<h2 id=\"the-reparenting-process\">The Reparenting Process<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#the-reparenting-process\"></a></h2>\n<p><em>Reparenting</em> adalah proses memberikan \"learning\" baru kepada diri sendiri untuk menggantikan keyakinan lama yang maladaptif.</p>\n<p><strong>Proses Transformasi Learning:</strong></p>\n<div class=\"table-responsive\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<table><thead><tr><th align=\"left\">Learning Lama (Maladaptif)</th><th align=\"left\">Learning Baru (Adaptif)</th></tr></thead><tbody><tr><td align=\"left\">\"Kalau gue peduli, gue dimanfaatin.\"</td><td align=\"left\">\"Gue bisa peduli dengan batas (boundary).\"</td></tr><tr><td align=\"left\">\"Kalau gue tampil, gue dipermalukan.\"</td><td align=\"left\">\"Gue bisa tampil kecil, tidak harus sempurna.\"</td></tr><tr><td align=\"left\">\"Kalau gue butuh orang, gue lemah.\"</td><td align=\"left\">\"Kebutuhan bukan kelemahan; cara memintanya yang perlu dilatih.\"</td></tr></tbody></table></div>\n<h2 id=\"post-traumatic-growth\">Post-Traumatic Growth<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#post-traumatic-growth\"></a></h2>\n<p>Target dari proses ini bukan sekadar menghilangkan rasa sakit, tetapi mencapai <em>post-traumatic growth</em>: kondisi di mana individu mampu menggunakan pengalaman traumatisnya untuk membangun kekuatan, empati, dan ketangguhan baru.</p>\n<blockquote>\n<p><strong>Atomic Idea</strong>: Trauma yang tidak diberi learning akan mengulang diri sebagai refleks.</p>\n</blockquote>\n<p>See also: <a href=\"/sotoy/notes/notes.psychology.maladaptive-memory\">Maladaptive Memory vs Adaptive Learning</a>, <a href=\"/sotoy/notes/notes.psychology.recurring-patterns-vs-incidents\">Recurring Patterns vs Incidents</a></p>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">psychology (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">trauma (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">reparenting (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">growth (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/notes.psychology.layer-psychological\">Psychological Layer: Trauma and Templates</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskC