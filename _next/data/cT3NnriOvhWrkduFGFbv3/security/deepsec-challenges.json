{"pageProps":{"note":{"id":"notes.security.deepsec-challenges","title":"Deepsec challenge: orchestration, false positives, cost, dan workflow","desc":"Rangkuman counter-argument di thread Guillermo Rauch tentang deepsec, fokus pada risk dan limitasi operasional.","updated":1777995719366,"created":1777991278760,"tags":["notes","security","deepsec","ai-security"],"custom":{},"fname":"notes.security.deepsec-challenges","type":"note","vault":{"fsPath":"vault"},"contentHash":"7d3008d2b8e9a411d8d18ee12b4cdc51","links":[{"type":"frontmatterTag","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"tags.notes","alias":"notes","xvault":false,"to":{"fname":"tags.notes"}},{"type":"frontmatterTag","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"tags.security","alias":"security","xvault":false,"to":{"fname":"tags.security"}},{"type":"frontmatterTag","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"tags.deepsec","alias":"deepsec","xvault":false,"to":{"fname":"tags.deepsec"}},{"type":"frontmatterTag","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"tags.ai-security","alias":"ai-security","xvault":false,"to":{"fname":"tags.ai-security"}},{"type":"wiki","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"notes.security.deepsec-harness","position":{"start":{"line":70,"column":3,"offset":3955},"end":{"line":70,"column":37,"offset":3989},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.security.deepsec-harness"}},{"type":"wiki","from":{"fname":"notes.security.deepsec-challenges","id":"notes.security.deepsec-challenges","vaultName":"vault"},"value":"notes.security.deepsec-docs","position":{"start":{"line":71,"colu