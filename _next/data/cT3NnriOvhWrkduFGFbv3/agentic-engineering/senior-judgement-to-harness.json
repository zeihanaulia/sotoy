ine":15,"column":3,"offset":615},"end":{"line":15,"column":60,"offset":672},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"zettel.20260507102000","id":"zettel.20260507102000","vaultName":"vault"},"type":"backlink","position":{"start":{"line":15,"column":3,"offset":673},"end":{"line":15,"column":60,"offset":730},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"notes.agentic-engineering.ai-slop-disposable-experimentation","id":"notes.agentic-engineering.ai-slop-disposable-experimentation","vaultName":"vault"},"type":"backlink","position":{"start":{"line":132,"column":3,"offset":8499},"end":{"line":132,"column":60,"offset":8556},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"notes.agentic-engineering.before-after-judgement-harness","id":"notes.agentic-engineering.before-after-judgement-harness","vaultName":"vault"},"type":"backlink","position":{"start":{"line":723,"column":3,"offset":17495},"end":{"line":723,"column":60,"offset":17552},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"notes.agentic-engineering.how-i-use-ai-to-code","id":"notes.agentic-engineering.how-i-use-ai-to-code","vaultName":"vault"},"type":"backlink","position":{"start":{"line":155,"column":3,"offset":8021},"end":{"line":155,"column":60,"offset":8078},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering","id":"notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":113,"column":3,"offset":9742},"end":{"line":113,"column":60,"offset":9799},"indent":[]},"value":"notes.agentic-engineering.senior-judgement-to-harness"},{"from":{"fname":"zettel.literature.how-i-use-ai-to-code","id":"zettel.literature.how-i-use-ai-to-code",