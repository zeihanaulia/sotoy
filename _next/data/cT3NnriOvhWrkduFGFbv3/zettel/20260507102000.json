e":false,"to":{"fname":"zettel.20260507100200"}},{"type":"wiki","from":{"fname":"zettel.20260507102000","id":"zettel.20260507102000","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":14,"column":3,"offset":636},"end":{"line":14,"column":37,"offset":670},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507102000","id":"zettel.20260507102000","vaultName":"vault"},"value":"notes.agentic-engineering.senior-judgement-to-harness","position":{"start":{"line":15,"column":3,"offset":673},"end":{"line":15,"column":60,"offset":730},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.senior-judgement-to-harness"}},{"from":{"fname":"zettel.moc.agentic-engineering","id":"zettel.moc.agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":65,"column":3,"offset":4391},"end":{"line":65,"column":28,"offset":4416},"indent":[]},"value":"zettel.20260507102000"}],"anchors":{},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"ai-may-speed-delivery-but-engineering-responsibility-stays-with-humans\">AI may speed delivery, but engineering responsibility stays with humans<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#ai-may-speed-delivery-but-engineering-responsibility-stays-with-humans\"></a></h1>\n<p>Claim: AI dapat mempercepat delivery, tetapi tidak memindahkan tanggung jawab engineering; manusia tetap bertanggung jawab atas keamanan, maintainability, dan kualitas.</p>\n<p>Evidence:</p>\n<ul>\n<li>Karpathy: \"You're still responsible for your software just as before,\" plus perbedaan antara vibe coding yang menaikkan floor dan agentic engineering yang mempertahankan quality bar.</li>\n</ul>\n<p>Why it matters:</p>\n<ul>\n<li>Mengingatkan tim bahwa kecepatan AI tidak berarti mitigasi tanggung jawab.</li>\n<li>Menjaga standards profesional ketika adopsi AI melonjak.</li>\n</ul>\n<p>See also:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering\">Andrej Karpathy: From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507100200\">Agentic engineering preserves quality bar while vibe coding raises floor</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.senior-judgement-to-harness\">Senior Judgement yang Dipindahkan ke Harness</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">engineering (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">responsibility (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.d