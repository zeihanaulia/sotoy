":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.20260507100800"}},{"type":"wiki","from":{"fname":"zettel.20260507100900","id":"zettel.20260507100900","vaultName":"vault"},"value":"zettel.20260507100200","position":{"start":{"line":15,"column":3,"offset":740},"end":{"line":15,"column":28,"offset":765},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.20260507100200"}},{"type":"wiki","from":{"fname":"zettel.20260507100900","id":"zettel.20260507100900","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":16,"column":3,"offset":768},"end":{"line":16,"column":37,"offset":802},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507100900","id":"zettel.20260507100900","vaultName":"vault"},"value":"notes.agentic-engineering.how-i-use-ai-to-code","position":{"start":{"line":17,"column":3,"offset":805},"end":{"line":17,"column":53,"offset":855},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.how-i-use-ai-to-code"}},{"from":{"fname":"notes.agentic-engineering.ai-slop-disposable-experimentation","id":"notes.agentic-engineering.ai-slop-disposable-experimentation","vaultName":"vault"},"type":"backlink","position":{"start":{"line":133,"column":3,"offset":8559},"end":{"line":133,"column":28,"offset":8584},"indent":[]},"value":"zettel.20260507100900"},{"from":{"fname":"zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering","id":"zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":44,"column":3,"offset":3807},"end":{"line":44,"column":28,"offset":3832},"indent":[]},"value":"zettel.20260507100900"},{"from":{"fname":"zettel.moc.agentic-engineering","id":"zettel.moc.agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":54,"column":3,"offset":3344},"end":{"line":54,"column":28,"offset":3369},"indent":[]},"value":"zettel.20260507100900"}],"anchors":{},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"vibe-coding-is-exploration-flow-not-quality-discipline\">Vibe coding is exploration flow, not quality discipline<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#vibe-coding-is-exploration-flow-not-quality-discipline\"></a></h1>\n<p>Claim: Vibe coding muncul saat kepercayaan terhadap AI sudah cukup tinggi sehingga seseorang terus memberi intent, menerima output, iterasi, dan tidak lagi mengontrol setiap baris sejak awal.</p>\n<p>Evidence:</p>\n<ul>\n<li>Karpathy: \"then I was vibe coding\" setelah dia merasa sistem makin bisa diandalkan.</li>\n<li>Dia menyiratkan bahwa vibe coding bukan ngawur, tapi mode eksplorasi cepat yang muncul dari aliran trust.</li>\n</ul>\n<p>Why it matters:</p>\n<ul>\n<li>Menjelaskan bahwa vibe coding adalah kondisi workflow, bukan definisi teknik engineering.</li>\n<li>Mengingatkan bahwa flow ini produktif untuk eksplorasi, tetapi berbahaya untuk production tanpa layer verifikasi.</li>\n</ul>\n<p>See also:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering\">Andrej Karpathy: From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507100800\">Trust threshold shifts AI workflow from assistant to production</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507100200\">Agentic engineering preserves quality bar while vibe coding raises floor</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.how-i-use-ai-to-code\">How I Use AI to Code</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">ai (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">vibe-coding (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">agentic-engineering (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.ai-slop-disposable-experimentation\">AI Slop dan Batas Disposable Experimentation</a></li>\n<li><a href=\"/sotoy/notes/zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering\">Karpathy — From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"