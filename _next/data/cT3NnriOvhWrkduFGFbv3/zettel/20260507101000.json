":{"line":14,"column":3,"offset":797},"end":{"line":14,"column":73,"offset":867},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101000","id":"zettel.20260507101000","vaultName":"vault"},"value":"zettel.20260507100100","position":{"start":{"line":15,"column":3,"offset":870},"end":{"line":15,"column":28,"offset":895},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.20260507100100"}},{"type":"wiki","from":{"fname":"zettel.20260507101000","id":"zettel.20260507101000","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":16,"column":3,"offset":898},"end":{"line":16,"column":37,"offset":932},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"type":"wiki","from":{"fname":"zettel.20260507101000","id":"zettel.20260507101000","vaultName":"vault"},"value":"notes.agentic-engineering.openclaw.personal-agent-orchestration","position":{"start":{"line":17,"column":3,"offset":935},"end":{"line":17,"column":70,"offset":1002},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.openclaw.personal-agent-orchestration"}},{"from":{"fname":"zettel.20260507101100","id":"zettel.20260507101100","vaultName":"vault"},"type":"backlink","position":{"start":{"line":14,"column":3,"offset":769},"end":{"line":14,"column":28,"offset":794},"indent":[]},"value":"zettel.20260507101000"},{"from":{"fname":"zettel.moc.agentic-engineering","id":"zettel.moc.agentic-engineering","vaultName":"vault"},"type":"backlink","position":{"start":{"line":55,"column":3,"offset":3430},"end":{"line":55,"column":28,"offset":3455},"indent":[]},"value":"zettel.20260507101000"}],"anchors":{},"children":[],"parent":"zettel","data":{}},"body":"<h1 id=\"context-window-is-temporary-source-code-for-llms\">Context window is temporary source code for LLMs<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#context-window-is-temporary-source-code-for-llms\"></a></h1>\n<p>Claim: Dalam Software 3.0, programming tidak lagi hanya menulis kode eksplisit. Sebaliknya, prompt dan context window berfungsi sebagai source code sementara yang mengendalikan interpreter LLM.</p>\n<p>Evidence:</p>\n<ul>\n<li>Karpathy: \"your programming now turns to prompting and what's in the context window is your lever over the interpreter that is the LLM.\"</li>\n<li>Dia membandingkan Software 1.0 (kode eksplisit), Software 2.0 (dataset + neural network), dan Software 3.0 (prompt/context).</li>\n</ul>\n<p>Why it matters:</p>\n<ul>\n<li>Mengubah cara kita memandang artifact engineering dari skrip menjadi instruksi kontekstual.</li>\n<li>Menegaskan bahwa nilai engineering di era agentic AI bergeser ke desain konteks dan instruksi, bukan hanya ke detail kode.</li>\n</ul>\n<p>See also:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.youtube.andrej-karpathy-from-vibe-coding-to-agentic-engineering\">Andrej Karpathy: From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.literature.karpathy-from-vibe-coding-to-agentic-engineering\">Karpathy — From Vibe Coding to Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/zettel.20260507100100\">Prompt and context become source code in Software 3.0</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n<li><a href=\"/sotoy/notes/notes.agentic-engineering.openclaw-personal-agent-orchestration\">Personal Agent Orchestration</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">software-3-0 (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">prompt-engineering (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">agentic-engineering (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/zettel.20260507101100\">Agent instructions replace deterministic scripting in variable environments</a></li>\n<li><a href=\"/sotoy/notes/zettel.moc.agentic-engineering\">MOC Agentic Engineering</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefinition":false,"enableXVaultWikiLink":false,"enableRemoteVaultInit":true,"enableUserTags":true,"enableHashTags":true,"workspaceVaultSyncMode":"noCommit","enableAutoFoldFrontmatter":false,"enableEditorDecorations":true,"maxPreviewsCached":10,"maxNoteLength":204800,"seeds":{"dendron.t