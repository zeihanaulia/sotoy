er-containers"}},{"type":"wiki","from":{"fname":"notes.orbstack-vs-docker-desktop","id":"notes.orbstack-vs-docker-desktop","vaultName":"vault"},"value":"notes.macos-development","position":{"start":{"line":325,"column":51,"offset":6918},"end":{"line":325,"column":78,"offset":6945},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.macos-development"}},{"from":{"fname":"notes.orbstack-docker-coexistence","id":"notes.orbstack-docker-coexistence","vaultName":"vault"},"type":"backlink","position":{"start":{"line":326,"column":1,"offset":7833},"end":{"line":326,"column":37,"offset":7869},"indent":[]},"value":"notes.orbstack-vs-docker-desktop"}],"anchors":{"orbstack-vs-docker-desktop":{"type":"header","text":"OrbStack vs Docker Desktop","value":"orbstack-vs-docker-desktop","line":15,"column":0,"depth":1},"apa-itu-orbstack":{"type":"header","text":"Apa itu OrbStack?","value":"apa-itu-orbstack","line":22,"column":0,"depth":2},"perbandingan-head-to-head":{"type":"header","text":"Perbandingan Head-to-Head","value":"perbandingan-head-to-head","line":37,"column":0,"depth":2},"performance":{"type":"header","text":"Performance","value":"performance","line":39,"column":0,"depth":3},"architecture":{"type":"header","text":"Architecture","value":"architecture","line":67,"column":0,"depth":3},"docker-desktop":{"type":"header","text":"Docker Desktop","value":"docker-desktop","line":69,"column":0,"depth":4},"orbstack":{"type":"header","text":"OrbStack","value":"orbstack","line":91,"column":0,"depth":4},"features-comparison":{"type":"header","text":"Features Comparison","value":"features-comparison","line":115,"column":0,"depth":3},"pricing":{"type":"header","text":"Pricing","value":"pricing","line":132,"column":0,"depth":3},"developer-experience":{"type":"header","text":"Developer Experience","value":"developer-experience","line":154,"column":0,"depth":3},"installation":{"type":"header","text":"Installation","value":"installation","line":156,"column":0,"depth":4},"daily-usage":{"type":"header","text":"Daily Usage","value":"daily-usage","line":168,"column":0,"depth":4},"vs-code-dev-containers":{"type":"header","text":"VS Code Dev Containers","value":"vs-code-dev-containers","line":179,"column":0,"depth":4},"networking":{"type":"header","text":"Networking","value":"networking","line":192,"column":0,"depth":3},"docker-desktop-1":{"type":"header","text":"Docker Desktop","value":"docker-desktop-1","line":194,"column":0,"depth":4},"orbstack-1":{"type":"header","text":"OrbStack","value":"orbstack-1","line":203,"column":0,"depth":4},"file-system-performance":{"type":"header","text":"File System Performance","value":"file-system-performance","line":218,"column":0,"depth":3},"when-to-choose-each":{"type":"header","text":"When to Choose Each","value":"when-to-choose-each","line":233,"column":0,"depth":2},"choose-orbstack-jika":{"type":"header","text":"Choose OrbStack jika:","value":"choose-orbstack-jika","line":235,"column":0,"depth":3},"choose-docker-desktop-jika":{"type":"header","text":"Choose Docker Desktop jika:","value":"choose-docker-desktop-jika","line":243,"column":0,"depth":3},"migration-path":{"type":"header","text":"Migration Path","value":"migration-path","line":252,"column":0,"depth":2},"from-docker-desktop-to-orbstack":{"type":"header","text":"From Docker Desktop to OrbStack","value":"from-docker-desktop-to-orbstack","line":254,"column":0,"depth":3},"limitations-to-know":{"type":"header","text":"Limitations to Know","value":"limitations-to-know","line":275,"column":0,"depth":2},"orbstack-limitations":{"type":"header","text":"OrbStack Limitations:","value":"orbstack-limitations","line":277,"column":0,"depth":3},"docker-desktop-limitations":{"type":"header","text":"Docker Desktop Limitations:","value":"docker-desktop-limitations","line":283,"column":0,"depth":3},"verdict":{"type":"header","text":"Verdict","value":"verdict","line":291,"column":0,"depth":2},"quick-start":{"type":"header","text":"Quick Start","value":"quick-start","line":308,"column":0,"depth":2},"install-orbstack":{"type":"header","text":"Install OrbStack","value":"install-orbstack","line":310,"column":0,"depth":3},"configure":{"type":"header","text":"Configure","value":"configure","line":315,"column":0,"depth":3},"test":{"type":"header","text":"Test","value":"test","line":321,"column":0,"depth":3},"references":{"type":"header","text":"References","value":"references","line":329,"column":0,"depth":2}},"children":[],"parent":"notes","data":{}},"body":"<h1 id=\"orbstack-vs-docker-desktop-perbandingan-lengkap\">OrbStack vs Docker Desktop: Perbandingan Lengkap<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#orbstack-vs-docker-desktop-perbandingan-lengkap\"></a></h1>\n<h1 id=\"orbstack-vs-docker-desktop\">OrbStack vs Docker Desktop<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#orbstack-vs-docker-desktop\"></a></h1>\n<p><strong>Last Updated:</strong> May 11, 2026<br>\n<strong>Ini note gue buat developer macOS yang ingin performa Docker lebih baik.</strong></p>\n<hr>\n<h2 id=\"apa-itu-orbstack\">Apa itu OrbStack?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#apa-itu-orbstack\"></a></h2>\n<p>OrbStack adalah alternatif modern untuk Docker Desktop, khusus dirancang untuk <strong>macOS</strong>. Menggunakan virtualisasi native macOS (Apple Hypervisor.framework) alih-alih Linux VM tradisional.</p>\n<p>Dari perspektif gue, ini perbandingan yang masuk akal buat lo kalau lagi mempertimbangkan migrasi dari Docker Desktop.</p>\n<p><strong>Key Features:</strong></p>\n<ul>\n<li>🚀 10x lebih cepat dari Docker Desktop</li>\n<li>💾 10x lebih hemat RAM (~500MB vs ~5GB)</li>\n<li>⚡ Startup &#x3C;1 detik</li>\n<li>🔗 Native networking (no port forwarding)</li>\n<li>💰 Free untuk personal use, $9/month commercial</li>\n</ul>\n<hr>\n<h2 id=\"perbandingan-head-to-head\">Perbandingan Head-to-Head<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#perbandingan-head-to-head\"></a></h2>\n<h3 id=\"performance\">Performance<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#performance\"></a></h3>\n<div class=\"table-responsive\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<table><thead><tr><th>Metric</th><th>Docker Desktop</th><th>OrbStack</th><th>Winner</th></tr></thead><tbody><tr><td>Startup Time</td><td>30-60s</td><td>&#x3C;1s</td><td>🏆 OrbStack (60x)</td></tr><tr><td>RAM Usage (idle)</td><td>2-5GB</td><td>200-500MB</td><td>🏆 OrbStack (10x)</td></tr><tr><td>CPU Overhead</td><td>Signifikan</td><td>Minimal</td><td>🏆 OrbStack</td></tr><tr><td>Disk I/O</td><td>Slow (virtiofs)</td><td>Fast (native)</td><td>🏆 OrbStack (2-3x)</td></tr><tr><td>Network Latency</td><td>Higher (NAT)</td><td>Native</td><td>🏆 OrbStack</td></tr><tr><td>Container Start</td><td>2-5s</td><td>&#x3C;0.5s</td><td>🏆 OrbStack</td></tr></tbody></table></div>\n<p><strong>Real-world benchmarks:</strong></p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token comment\"># Starting PostgreSQL container</span>\nDocker Desktop:  <span class=\"token number\">3</span>.2s\nOrbStack:        <span class=\"token number\">0</span>.4s   <span class=\"token punctuation\">(</span>8x faster<span class=\"token punctuation\">)</span>\n\n<span class=\"token comment\"># npm install (large project)</span>\nDocker Desktop:  45s\nOrbStack:        18s    <span class=\"token punctuation\">(</span><span class=\"token number\">2</span>.5x faster<span class=\"token punctuation\">)</span>\n\n<span class=\"token comment\"># Dev Container boot</span>\nDocker Desktop:  25s\nOrbStack:        3s     <span class=\"token punctuation\">(</span>8x faster<span class=\"token punctuation\">)</span>\n</code></pre>\n<hr>\n<h3 id=\"architecture\">Architecture<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#architecture\"></a></h3>\n<h4 id=\"docker-desktop\">Docker Desktop<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#docker-desktop\"></a></h4>\n<pre><code>┌─────────────────┐\n│   Docker CLI    │\n└────────┬────────┘\n         │\n┌────────▼────────┐\n│  Hyperkit VM    │ ← Full Linux VM (heavyweight)\n│  (2-5GB RAM)    │\n│  ┌───────────┐  │\n│  │ Docker    │  │\n│  │ Daemon    │  │\n│  └───────────┘  │\n└─────────────────┘\n</code></pre>\n<p><strong>Issues:</strong></p>\n<ul>\n<li>Full Linux VM = overhead besar</li>\n<li>Virtualized networking = port forwarding kompleks</li>\n<li>File sharing via virtiofs = slow I/O</li>\n<li>Memory pre-allocation = waste RAM</li>\n</ul>\n<h4 id=\"orbstack\">OrbStack<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#orbstack\"></a></h4>\n<pre><code>┌─────────────────┐\n│   OrbStack CLI  │\n└────────┬────────┘\n         │\n┌────────▼────────┐\n│ Apple Hypervisor│ ← Native macOS virtualization\n│ (lightweight)   │\n│ ┌───────────┐   │\n│ │ Container │   │\n│ │ Runtime   │   │\n│ └───────────┘   │\n└────────┬────────┘\n</code></pre>\n<p><strong>Advantages:</strong></p>\n<ul>\n<li>Uses Apple's Hypervisor.framework</li>\n<li>No full VM overhead</li>\n<li>Native networking (no NAT)</li>\n<li>Dynamic memory allocation</li>\n</ul>\n<hr>\n<h3 id=\"features-comparison\">Features Comparison<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#features-comparison\"></a></h3>\n<div class=\"table-responsive\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<table><thead><tr><th>Feature</th><th>Docker Desktop</th><th>OrbStack</th></tr></thead><tbody><tr><td>Docker API Compatible</td><td>✅</td><td>✅</td></tr><tr><td>Docker Compose</td><td>✅</td><td>✅</td></tr><tr><td>Kubernetes</td><td>✅</td><td>✅</td></tr><tr><td>Dev Containers</td><td>✅</td><td>✅</td></tr><tr><td>Multi-arch Support</td><td>✅</td><td>✅</td></tr><tr><td>Volume Mounts</td><td>✅</td><td>✅ (faster)</td></tr><tr><td>Dashboard UI</td><td>✅</td><td>✅</td></tr><tr><td>Extensions</td><td>✅ Many</td><td>⚠️ Limited</td></tr><tr><td>Commercial License</td><td>$9-29/month</td><td>$9/month</td></tr><tr><td>Platform</td><td>macOS, Windows, Linux</td><td><strong>macOS only</strong></td></tr></tbody></table></div>\n<hr>\n<h3 id=\"pricing\">Pricing<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#pricing\"></a></h3>\n<p><strong>Docker Desktop:</strong></p>\n<ul>\n<li>Personal (small companies &#x3C;25 employees): FREE</li>\n<li>Professional: $9/month</li>\n<li>Team: $24/month</li>\n<li>Business: $29/month</li>\n</ul>\n<p><strong>OrbStack:</strong></p>\n<ul>\n<li>Personal Use: <strong>FREE</strong> (unlimited)</li>\n<li>Commercial: $9/month or $90/year</li>\n<li>Student/OS: FREE (with verification)</li>\n</ul>\n<p><strong>Cost Analysis (10-person team):</strong></p>\n<pre><code>Docker Desktop Team: $24 × 10 × 12 = $2,880/year\nOrbStack Commercial: $90 × 10 = $900/year\nSavings: $1,980/year (69% cheaper)\n</code></pre>\n<hr>\n<h3 id=\"developer-experience\">Developer Experience<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#developer-experience\"></a></h3>\n<h4 id=\"installation\">Installation<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#installation\"></a></h4>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token comment\"># Docker Desktop</span>\nbrew <span class=\"token function\">install</span> --cask <span class=\"token function\">docker</span>\n<span class=\"token comment\"># ~5 minutes</span>\n\n<span class=\"token comment\"># OrbStack</span>\nbrew <span class=\"token function\">install</span> --cask orbstack\n<span class=\"token comment\"># ~30 seconds</span>\n</code></pre>\n<h4 id=\"daily-usage\">Daily Usage<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#daily-usage\"></a></h4>\n<p><strong>Both use identical commands:</strong></p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">docker-compose</span> up -d\n<span class=\"token function\">docker</span> run -it postgres:15\n<span class=\"token function\">docker</span> build -t myapp <span class=\"token builtin class-name\">.</span>\n</code></pre>\n<p><strong>No difference in CLI usage!</strong> OrbStack adalah drop-in replacement.</p>\n<h4 id=\"vs-code-dev-containers\">VS Code Dev Containers<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#vs-code-dev-containers\"></a></h4>\n<p>Both work identically. VS Code tidak bisa membedakan backend mana yang dipakai.</p>\n<pre class=\"language-json\"><code class=\"language-json\"><span class=\"token punctuation\">{</span>\n  <span class=\"token property\">\"name\"</span><span class=\"token operator\">:</span> <span class=\"token string\">\"My Dev Container\"</span><span class=\"token punctuation\">,</span>\n  <span class=\"token property\">\"image\"</span><span class=\"token operator\">:</span> <span class=\"token string\">\"node:18\"</span>\n<span class=\"token punctuation\">}</span>\n</code></pre>\n<hr>\n<h3 id=\"networking\">Networking<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#networking\"></a></h3>\n<h4 id=\"docker-desktop-1\">Docker Desktop<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#docker-desktop-1\"></a></h4>\n<pre><code>Container (172.17.0.2) \n    ↓ NAT\nVM Network (192.168.65.1)\n    ↓ Port Forwarding\nmacOS Host (localhost:8080)\n</code></pre>\n<h4 id=\"orbstack-1\">OrbStack<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#orbstack-1\"></a></h4>\n<pre><code>Container (native IP)\n    ↓ Direct routing\nmacOS Host (localhost:8080)\n</code></pre>\n<p><strong>OrbStack advantages:</strong></p>\n<ul>\n<li>No port forwarding needed</li>\n<li>Containers get real IPs</li>\n<li>Lower latency</li>\n<li><code>localhost</code> works as expected</li>\n</ul>\n<hr>\n<h3 id=\"file-system-performance\">File System Performance<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#file-system-performance\"></a></h3>\n<p><strong>Benchmark: <code>npm install</code> in mounted volume</strong></p>\n<pre><code>Docker Desktop:  45 seconds\nOrbStack:        12 seconds  (3.75x faster)\n</code></pre>\n<p><strong>Why?</strong></p>\n<ul>\n<li>Docker Desktop: virtiofs (slow translation layer)</li>\n<li>OrbStack: native macOS file system access</li>\n</ul>\n<hr>\n<h2 id=\"when-to-choose-each\">When to Choose Each<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#when-to-choose-each\"></a></h2>\n<h3 id=\"choose-orbstack-jika\">Choose <strong>OrbStack</strong> jika:<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#choose-orbstack-jika\"></a></h3>\n<ul>\n<li>✅ Developer di <strong>macOS</strong> (especially Apple Silicon)</li>\n<li>✅ Want better performance dan lower resource usage</li>\n<li>✅ Mostly local development</li>\n<li>✅ Use Dev Containers extensively</li>\n<li>✅ Frustrated dengan Docker Desktop lambat</li>\n<li>✅ Want simpler pricing</li>\n</ul>\n<h3 id=\"choose-docker-desktop-jika\">Choose <strong>Docker Desktop</strong> jika:<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#choose-docker-desktop-jika\"></a></h3>\n<ul>\n<li>✅ Need Docker Extensions ecosystem</li>\n<li>✅ Working in enterprise dengan compliance requirements</li>\n<li>✅ Using <strong>Windows atau Linux</strong></li>\n<li>✅ Need multi-node Kubernetes locally</li>\n<li>✅ Require official enterprise support</li>\n</ul>\n<hr>\n<h2 id=\"migration-path\">Migration Path<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#migration-path\"></a></h2>\n<h3 id=\"from-docker-desktop-to-orbstack\">From Docker Desktop to OrbStack<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#from-docker-desktop-to-orbstack\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token comment\"># 1. Install OrbStack</span>\nbrew <span class=\"token function\">install</span> --cask orbstack\n\n<span class=\"token comment\"># 2. Switch context</span>\n<span class=\"token function\">docker</span> context use orbstack\n\n<span class=\"token comment\"># 3. Verify</span>\n<span class=\"token function\">docker</span> info <span class=\"token operator\">|</span> <span class=\"token function\">grep</span> <span class=\"token string\">\"OrbStack\"</span>\n\n<span class=\"token comment\"># 4. (Optional) Uninstall Docker Desktop</span>\nbrew uninstall --cask <span class=\"token function\">docker</span>\n</code></pre>\n<p><strong>Migration Time:</strong> &#x3C;5 minutes<br>\n<strong>Data Loss:</strong> None</p>\n<hr>\n<h2 id=\"limitations-to-know\">Limitations to Know<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#limitations-to-know\"></a></h2>\n<h3 id=\"orbstack-limitations\">OrbStack Limitations:<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#orbstack-limitations\"></a></h3>\n<ol>\n<li><strong>macOS Only</strong> - Tidak ada Windows/Linux version</li>\n<li><strong>Newer Project</strong> - Less battle-tested (4 years vs 8+ years)</li>\n<li><strong>Fewer Extensions</strong> - Ecosystem masih berkembang</li>\n<li><strong>Commercial License</strong> - $9/month untuk business use</li>\n</ol>\n<h3 id=\"docker-desktop-limitations\">Docker Desktop Limitations:<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#docker-desktop-limitations\"></a></h3>\n<ol>\n<li><strong>Heavy Resource Usage</strong> - Especially on macOS</li>\n<li><strong>Slow Startup</strong> - VM boot time</li>\n<li><strong>Complex Licensing</strong> - Confusing free/paid tiers</li>\n<li><strong>Performance Issues</strong> - File I/O, networking overhead</li>\n</ol>\n<hr>\n<h2 id=\"verdict\">Verdict<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#verdict\"></a></h2>\n<div class=\"table-responsive\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<table><thead><tr><th>Category</th><th>Winner</th><th>Margin</th></tr></thead><tbody><tr><td>Performance</td><td>🏆 OrbStack</td><td>Massive</td></tr><tr><td>Resource Usage</td><td>🏆 OrbStack</td><td>Massive</td></tr><tr><td>Ease of Use</td><td>🏆 Tie</td><td>Equal</td></tr><tr><td>Features</td><td>🏆 Docker Desktop</td><td>Moderate</td></tr><tr><td>Pricing</td><td>🏆 OrbStack</td><td>Significant</td></tr><tr><td>Ecosystem</td><td>🏆 Docker Desktop</td><td>Moderate</td></tr><tr><td>Stability</td><td>🏆 Docker Desktop</td><td>Slight</td></tr><tr><td>macOS Integration</td><td>🏆 OrbStack</td><td>Massive</td></tr></tbody></table></div>\n<p><strong>Overall Winner for macOS Developers: 🏆 OrbStack</strong></p>\n<hr>\n<h2 id=\"quick-start\">Quick Start<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#quick-start\"></a></h2>\n<h3 id=\"install-orbstack\">Install OrbStack<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#install-orbstack\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\">brew <span class=\"token function\">install</span> --cask orbstack\n</code></pre>\n<h3 id=\"configure\">Configure<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#configure\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">docker</span> context use orbstack\n<span class=\"token function\">docker</span> info <span class=\"token operator\">|</span> <span class=\"token function\">grep</span> <span class=\"token string\">\"OrbStack\"</span>\n</code></pre>\n<h3 id=\"test\">Test<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#test\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">docker</span> run hello-world\n<span class=\"token comment\"># Should be noticeably faster!</span>\n</code></pre>\n<hr>\n<h2 id=\"references\">References<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#references\"></a></h2>\n<ul>\n<li>OrbStack Official: <a href=\"https://orbstack.dev/\">https://orbstack.dev/</a></li>\n<li>Docker Desktop: <a href=\"https://www.docker.com/products/docker-desktop/\">https://www.docker.com/products/docker-desktop/</a></li>\n<li>Benchmarks: <a href=\"https://orbstack.dev/blog/faster-docker\">https://orbstack.dev/blog/faster-docker</a></li>\n<li>Apple Hypervisor: <a href=\"https://developer.apple.com/documentation/hypervisor\">https://developer.apple.com/documentation/hypervisor</a></li>\n</ul>\n<hr>\n<p><strong>Related:</strong> <a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">notes.docker-containers (Private)</a> <em>(TODO)</em> <a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">notes.macos-development (Private)</a> <em>(TODO)</em></p>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #7ef4cc;\" href=\"/sotoy/notes/tags.docker\">docker</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">orbstack (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">development-tools (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">macos (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">containers (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/notes.orbstack-docker-coexistence\">Apakah Perlu Uninstall Docker Desktop Saat Install OrbStack?</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extr