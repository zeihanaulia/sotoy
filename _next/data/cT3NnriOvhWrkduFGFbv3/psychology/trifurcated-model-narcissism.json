ine":27,"column":48,"offset":1838},"end":{"line":27,"column":87,"offset":1877},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.agentic-narcissism"}},{"type":"wiki","from":{"fname":"notes.psychology.trifurcated-model-narcissism","id":"notes.psychology.trifurcated-model-narcissism","vaultName":"vault"},"value":"notes.psychology.antagonistic-narcissism","position":{"start":{"line":27,"column":89,"offset":1879},"end":{"line":27,"column":133,"offset":1923},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.antagonistic-narcissism"}},{"type":"wiki","from":{"fname":"notes.psychology.trifurcated-model-narcissism","id":"notes.psychology.trifurcated-model-narcissism","vaultName":"vault"},"value":"notes.psychology.neurotic-narcissism","position":{"start":{"line":27,"column":135,"offset":1925},"end":{"line":27,"column":175,"offset":1965},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.neurotic-narcissism"}},{"from":{"fname":"notes.psychology.agentic-narcissism","id":"notes.psychology.agentic-narcissism","vaultName":"vault"},"type":"backlink","position":{"start":{"line":17,"column":11,"offset":942},"end":{"line":17,"column":60,"offset":991},"indent":[]},"value":"notes.psychology.trifurcated-model-narcissism"},{"from":{"fname":"notes.psychology.antagonistic-narcissism","id":"notes.psychology.antagonistic-narcissism","vaultName":"vault"},"type":"backlink","position":{"start":{"line":20,"column":11,"offset":1084},"end":{"line":20,"column":60,"offset":1133},"indent":[]},"value":"notes.psychology.trifurcated-model-narcissism"},{"from":{"fname":"notes.psychology.neurotic-narcissism","id":"notes.psychology.neurotic-narcissism","vaultName":"vault"},"type":"backlink","position":{"start":{"line":20,"column":11,"offset":1074},"end":{"line":20,"column":60,"offset":1123},"indent":[]},"value":"notes.psychology.trifurcated-model-narcissism"},{"from":{"fname":"notes.psychology.npd-definition","id":"notes.psychology.npd-definition","vaultName":"vault"},"type":"backlink","position":{"start":{"line":21,"column":11,"offset":1371},"end":{"line":21,"column":60,"offset":1420},"indent":[]},"value":"notes.psychology.trifurcated-model-narcissism"}],"anchors":{"trifurcated-model-of-narcissism":{"type":"header","text":"Trifurcated Model of Narcissism","value":"trifurcated-model-of-narcissism","line":15,"column":0,"depth":1},"overview":{"type":"header","text":"Overview","value":"overview","line":17,"column":0,"depth":2},"the-three-dimensions":{"type":"header","text":"The Three Dimensions","value":"the-three-dimensions","line":20,"column":0,"depth":2},"relationship-to-grandiose--vulnerable-narcissism":{"type":"header","text":"Relationship to Grandiose & Vulnerable Narcissism","value":"relationship-to-grandiose--vulnerable-narcissism","line":27,"column":0,"depth":2},"practical-application":{"type":"header","text":"Practical Application","value":"practical-application","line":34,"column":0,"depth":2}},"children":[],"parent":"k7whujrtxo2tvftwjvbq1jh","data":{}},"body":"<h1 id=\"trifurcated-model-of-narcissism\">Trifurcated Model of Narcissism<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#trifurcated-model-of-narcissism\"></a></h1>\n<h1 id=\"trifurcated-model-of-narcissism-1\">Trifurcated Model of Narcissism<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#trifurcated-model-of-narcissism-1\"></a></h1>\n<h2 id=\"overview\">Overview<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#overview\"></a></h2>\n<p>Trifurcated Model (atau Three-Factor Model) melihat narsisme bukan sebagai satu diagnosis tunggal, melainkan sebagai kombinasi dari tiga dimensi sifat yang bisa bercampur dalam satu individu. Model ini didasarkan pada penelitian seperti <em>Five-Factor Narcissism Inventory</em> (FFNI) oleh Miller dkk. dan pengembangan oleh Crowe dkk.</p>\n<h2 id=\"the-three-dimensions\">The Three Dimensions<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#the-three-dimensions\"></a></h2>\n<p>Narsisme digerakkan oleh tiga \"mesin\" utama:</p>\n<ol>\n<li><strong>Agentic Extraversion (Agentik)</strong>: Mesin untuk tampil dan menang. Berorientasi pada aksi, prestasi, dominasi sosial positif, dan kepercayaan diri.</li>\n<li><strong>Self-centered Antagonism (Antagonis)</strong>: Mesin untuk menguasai dan merendahkan. Berorientasi pada <em>entitlement</em>, arogansi, eksploitasi, dan kurangnya empati.</li>\n<li><strong>Narcissistic Neuroticism (Neurotik)</strong>: Mesin yang merasa terluka dan butuh validasi. Berorientasi pada rasa malu (<em>shame</em>), sensitivitas tinggi terhadap kritik, dan perasaan menjadi korban.</li>\n</ol>\n<h2 id=\"relationship-to-grandiose--vulnerable-narcissism\">Relationship to Grandiose &#x26; Vulnerable Narcissism<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#relationship-to-grandiose--vulnerable-narcissism\"></a></h2>\n<p>Model ini memperjelas struktur dari dua tipe narsisme klasik:</p>\n<ul>\n<li><strong>Grandiose Narcissism</strong> <span class=\"math math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>≈</mo></mrow><annotation encoding=\"application/x-tex\">\\approx</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4831em;\"></span><span class=\"mrel\">≈</span></span></span></span></span> Agentic Extraversion + Antagonism.</li>\n<li><strong>Vulnerable Narcissism</strong> <span class=\"math math-inline\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>≈</mo></mrow><annotation encoding=\"application/x-tex\">\\approx</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4831em;\"></span><span class=\"mrel\">≈</span></span></span></span></span> Narcissistic Neuroticism + Antagonism.</li>\n</ul>\n<p><strong>Key Insight</strong>: Antagonisme adalah benang merah yang menghubungkan keduanya. Seseorang bisa tampak percaya diri (grandiose) atau rapuh (vulnerable), tetapi yang membuatnya berbahaya secara sosial adalah tingginya kadar <strong>Antagonisme</strong>.</p>\n<h2 id=\"practical-application\">Practical Application<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#practical-application\"></a></h2>\n<p>Model ini digunakan untuk membaca pola, bukan melabel orang:</p>\n<ul>\n<li><strong>Agentik tanpa Antagonis</strong>: Pemimpin yang percaya diri dan produktif.</li>\n<li><strong>Neurotik tanpa Antagonis</strong>: Orang rapuh yang membutuhkan dukungan emosional.</li>\n<li><strong>Antagonis Tinggi</strong>: Risiko sosial tinggi; relasi menjadi medan kuasa dan eksploitasi.</li>\n</ul>\n<p>See also: <a href=\"/sotoy/notes/notes.psychology.npd-definition\">Narcissistic Personality Disorder (NPD) as an Exploitation System</a>, <a href=\"/sotoy/notes/notes.psychology.agentic-narcissism\">Agentic Narcissism (Agentic Extraversion)</a>, <a href=\"/sotoy/notes/notes.psychology.antagonistic-narcissism\">Antagonistic Narcissism (Self-centered Antagonism)</a>, <a href=\"/sotoy/notes/notes.psychology.neurotic-narcissism\">Neurotic Narcissism (Narcissistic Neuroticism)</a></p>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">psychology (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">npd (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">personality-traits (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/notes.psychology.agentic-narcissism\">Agentic Narcissism (Agentic Extraversion)</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.antagonistic-narcissism\">Antagonistic Narcissism (Self-centered Antagonism)</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.neurotic-narcissism\">Neurotic Narcissism (Narcissistic Neuroticism)</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.npd-definition\">Narcissistic Personality Disorder (NPD) as an Exploitation System</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefinition":false,"enableXVaultWikiLink":false,"enableRemoteVaultInit":true,"enableUserTags":true,"enableHashTags":true,"workspaceVaultSyncMode":"noCommit","enableAutoFoldFrontmatter":false,"enableEditorDecorations":true,"maxPreviewsCached":10,"maxNoteLength":204800,"seeds":{"dendron.templates":{}},"enableFullHierarchyNoteTitle":false},"p