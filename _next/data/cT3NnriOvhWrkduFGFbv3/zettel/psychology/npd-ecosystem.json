gy.npd-ecosystem","vaultName":"vault"},"value":"notes.psychology.boundary-vs-reality-check","position":{"start":{"line":17,"column":120,"offset":1221},"end":{"line":17,"column":180,"offset":1281},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.boundary-vs-reality-check","anchorHeader":"reality-check"}},{"type":"wiki","from":{"fname":"zettel.psychology.npd-ecosystem","id":"zettel.psychology.npd-ecosystem","vaultName":"vault"},"value":"notes.psychology.trauma-detection-standard","position":{"start":{"line":18,"column":101,"offset":1384},"end":{"line":18,"column":147,"offset":1430},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.trauma-detection-standard"}},{"type":"wiki","from":{"fname":"zettel.psychology.npd-ecosystem","id":"zettel.psychology.npd-ecosystem","vaultName":"vault"},"value":"notes.psychology.npd-definition","position":{"start":{"line":27,"column":3,"offset":1895},"end":{"line":27,"column":38,"offset":1930},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.npd-definition"}},{"type":"wiki","from":{"fname":"zettel.psychology.npd-ecosystem","id":"zettel.psychology.npd-ecosystem","vaultName":"vault"},"value":"notes.psychology.boundary-vs-reality-check","position":{"start":{"line":28,"column":3,"offset":1933},"end":{"line":28,"column":49,"offset":1979},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.boundary-vs-reality-check"}},{"type":"wiki","from":{"fname":"zettel.psychology.npd-ecosystem","id":"zettel.psychology.npd-ecosystem","vaultName":"vault"},"value":"notes.psychology.trauma-detection-standard","position":{"start":{"line":29,"column":3,"offset":1982},"end":{"line":29,"column":49,"offset":2028},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.psychology.trauma-detection-standard"}}],"anchors":{"npd-as-a-social-ecosystem-disruptor":{"type":"header","text":"NPD as a Social Ecosystem Disruptor","value":"npd-as-a-social-ecosystem-disruptor","line":16,"column":0,"depth":1},"thesis":{"type":"header","text":"Thesis","value":"thesis","line":18,"column":0,"depth":2},"the-mechanism-of-exploitation":{"type":"header","text":"The Mechanism of Exploitation","value":"the-mechanism-of-exploitation","line":21,"column":0,"depth":2},"the-enabling-environment":{"type":"header","text":"The Enabling Environment","value":"the-enabling-environment","line":28,"column":0,"depth":2},"conclusion-the-path-to-resilience":{"type":"header","text":"Conclusion: The Path to Resilience","value":"conclusion-the-path-to-resilience","line":34,"column":0,"depth":2}},"children":[],"parent":"2ty2jd663fk0agyi3qo3cz7","data":{}},"body":"<h1 id=\"npd-as-a-social-ecosystem-disruptor\">NPD as a Social Ecosystem Disruptor<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#npd-as-a-social-ecosystem-disruptor\"></a></h1>\n<h1 id=\"npd-as-a-social-ecosystem-disruptor-1\">NPD as a Social Ecosystem Disruptor<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#npd-as-a-social-ecosystem-disruptor-1\"></a></h1>\n<h2 id=\"thesis\">Thesis<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#thesis\"></a></h2>\n<p>Narcissistic Personality Disorder (NPD) bukan sekadar masalah klinis individu, melainkan sebuah <strong>sistem eksploitasi</strong> yang efektivitasnya bergantung pada kerentanan korban dan dukungan struktur sosial/budaya.</p>\n<h2 id=\"the-mechanism-of-exploitation\">The Mechanism of Exploitation<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#the-mechanism-of-exploitation\"></a></h2>\n<p>NPD bekerja dengan mengubah kebutuhan dasar manusia akan pengakuan menjadi alat kontrol. Berdasarkan <strong>Trifurcated Model</strong>, hal ini digerakkan oleh tiga mesin:</p>\n<ul>\n<li><strong>Agentik</strong>: Energi ekspansi diri (bisa sehat jika dikawal realitas).</li>\n<li><strong>Neurotik</strong>: Luka yang menuntut perhatian (bisa menjadi manipulasi <em>victimhood</em>).</li>\n<li><strong>Antagonis</strong>: Inti gelap yang mengubah orang lain menjadi alat.</li>\n</ul>\n<p>NPD menjadi berbahaya ketika <strong>Antagonisme</strong> tinggi, karena di situlah <em>entitlement</em>, kurang empati, dan agresi interpersonal muncul paling kuat.</p>\n<h2 id=\"the-enabling-environment\">The Enabling Environment<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#the-enabling-environment\"></a></h2>\n<p>Sistem eksploitasi ini tumbuh subur dalam kondisi berikut:</p>\n<ol>\n<li><strong>Kultural</strong>: Budaya \"nggak enakan\", pemujaan hierarki, dan rasionalisasi kekerasan atas nama senioritas/keluarga (menghancurkan <a href=\"/sotoy/notes/notes.psychology.boundary-vs-reality-check#boundary\">Boundary vs Reality Check</a>).</li>\n<li><strong>Digital</strong>: Arsitektur media sosial yang memberikan validasi instan tanpa konsekuensi interpersonal (menghancurkan <a href=\"/sotoy/notes/notes.psychology.boundary-vs-reality-check#reality-check\">Boundary vs Reality Check</a>).</li>\n<li><strong>Psikologis</strong>: Korban dengan trauma masa lalu yang memiliki standar deteksi bahaya yang rendah (<a href=\"/sotoy/notes/notes.psychology.trauma-detection-standard\">Trauma and the Lowering of Danger Detection Standards</a>).</li>\n</ol>\n<h2 id=\"conclusion-the-path-to-resilience\">Conclusion: The Path to Resilience<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#conclusion-the-path-to-resilience\"></a></h2>\n<p>Resiliensi terhadap pola NPD tidak cukup hanya dengan \"menjauhi orang toxic\", tetapi harus melalui pembangunan ulang sistem pertahanan internal:</p>\n<ul>\n<li><strong>Kognitif</strong>: Memperkuat <em>Reality Check</em> untuk membedakan ambisi vs fantasi.</li>\n<li><strong>Relasional</strong>: Membangun <em>Boundary</em> yang tegas untuk mencegah empati menjadi pintu eksploitasi.</li>\n<li><strong>Holistik</strong>: Pendekatan biopsikososial-kultural-spiritual untuk memutus rantai trauma.</li>\n</ul>\n<p>Links:</p>\n<ul>\n<li><a href=\"/sotoy/notes/notes.psychology.npd-definition\">Narcissistic Personality Disorder (NPD) as an Exploitation System</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.boundary-vs-reality-check\">Boundary vs Reality Check</a></li>\n<li><a href=\"/sotoy/notes/notes.psychology.trauma-detection-standard\">Trauma and the Lowering of Danger Detection Standards</a></li>\n</ul>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a class=\"color-tag\" style=\"--tag-color: #a03623;\" href=\"/sotoy/notes/tags.zettel\">zettel</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">psychology (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">npd (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">sociology (Private)</a></li>\n</ol>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter / X](https://x.com/zeihanaulia)\n\nThanks for stopping by. If you have feedback or want to chat, feel free to reach out.\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"dendronVersion":"0.83.0","vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"priorityS