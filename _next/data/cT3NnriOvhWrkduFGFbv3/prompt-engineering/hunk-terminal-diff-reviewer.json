g.hunk-terminal-diff-reviewer","id":"notes.prompt-engineering.hunk-terminal-diff-reviewer","vaultName":"vault"},"value":"tags.jj","alias":"jj","xvault":false,"to":{"fname":"tags.jj"}},{"type":"frontmatterTag","from":{"fname":"notes.prompt-engineering.hunk-terminal-diff-reviewer","id":"notes.prompt-engineering.hunk-terminal-diff-reviewer","vaultName":"vault"},"value":"tags.jujutsu","alias":"jujutsu","xvault":false,"to":{"fname":"tags.jujutsu"}},{"type":"frontmatterTag","from":{"fname":"notes.prompt-engineering.hunk-terminal-diff-reviewer","id":"notes.prompt-engineering.hunk-terminal-diff-reviewer","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"notes.prompt-engineering.hunk-terminal-diff-reviewer","id":"notes.prompt-engineering.hunk-terminal-diff-reviewer","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}},{"from":{"fname":"daily.journal.2026.05.11","id":"daily.journal.2026.05.11","vaultName":"vault"},"type":"backlink","position":{"start":{"line":14,"column":3,"offset":1089},"end":{"line":14,"column":59,"offset":1145},"indent":[]},"value":"notes.prompt-engineering.hunk-terminal-diff-reviewer"}],"anchors":{"apa-itu-hunk":{"type":"header","text":"Apa itu Hunk?","value":"apa-itu-hunk","line":20,"column":0,"depth":2},"kenapa-mitchell-mengganti-diff-viewer-lain":{"type":"header","text":"Kenapa Mitchell mengganti diff viewer lain?","value":"kenapa-mitchell-mengganti-diff-viewer-lain","line":34,"column":0,"depth":2},"apa-itu-jj--jujutsu-di-konteks-ini":{"type":"header","text":"Apa itu jj / Jujutsu di konteks ini?","value":"apa-itu-jj--jujutsu-di-konteks-ini","line":48,"column":0,"depth":2},"use-case-paling-cocok-buat-apa":{"type":"header","text":"Use case paling cocok buat apa?","value":"use-case-paling-cocok-buat-apa","line":61,"column":0,"depth":2},"cara-pakainya":{"type":"header","text":"Cara pakainya","value":"cara-pakainya","line":84,"column":0,"depth":2},"dasar":{"type":"header","text":"Dasar","value":"dasar","line":86,"column":0,"depth":3},"review-repo-git":{"type":"header","text":"Review repo Git","value":"review-repo-git","line":103,"column":0,"depth":3},"live-watch-mode":{"type":"header","text":"Live watch mode","value":"live-watch-mode","line":111,"column":0,"depth":3},"review-patch-dari-pipe":{"type":"header","text":"Review patch dari pipe","value":"review-patch-dari-pipe","line":118,"column":0,"depth":3},"integrasi-git-pager":{"type":"header","text":"Integrasi Git pager","value":"integrasi-git-pager","line":124,"column":0,"depth":3},"integrasi-jujutsu-jj":{"type":"header","text":"Integrasi Jujutsu (JJ)","value":"integrasi-jujutsu-jj","line":146,"column":0,"depth":3},"limitasi-dibanding-tool-diff-lain":{"type":"header","text":"Limitasi dibanding tool diff lain","value":"limitasi-dibanding-tool-diff-lain","line":164,"column":0,"depth":2},"kesimpulan":{"type":"header","text":"Kesimpulan","value":"kesimpulan","line":175,"column":0,"depth":2}},"children":[],"parent":"notes.prompt-engineering","data":{}},"body":"<h1 id=\"hunk-review-first-terminal-diff-viewer-untuk-changeset\">Hunk: review-first terminal diff viewer untuk changeset<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#hunk-review-first-terminal-diff-viewer-untuk-changeset\"></a></h1>\n<h2 id=\"apa-itu-hunk\">Apa itu Hunk?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#apa-itu-hunk\"></a></h2>\n<p>Gue lihat Hunk sebagai terminal diff viewer yang bukan sekadar <code>git diff</code> berwarna.\nHunk lebih mirip <strong>local code review UI untuk changeset</strong>, dengan:</p>\n<ul>\n<li>sidebar file navigation</li>\n<li>multi-file review stream</li>\n<li>split/stack layout</li>\n<li>mouse + keyboard support</li>\n<li>auto-reload/watch mode</li>\n<li>agent/AI annotation workflow</li>\n</ul>\n<p>Di dokumentasinya dia menyebut diri sebagai \"review-first terminal diff viewer for agent-authored changesets\". Itu kena banget: fokusnya bukan tampilan patch, tapi membuat diff terasa seperti sesi review.</p>\n<h2 id=\"kenapa-mitchell-mengganti-diff-viewer-lain\">Kenapa Mitchell mengganti diff viewer lain?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#kenapa-mitchell-mengganti-diff-viewer-lain\"></a></h2>\n<p>Di thread Mitchell dia bilang beberapa hal penting:</p>\n<ul>\n<li>looks good</li>\n<li>speedy</li>\n<li>good keyboard shortcuts</li>\n<li>good mouse support for fallback</li>\n</ul>\n<p>Itu bukan pujian default buat tool terminal.\nGue baca sebagai sinyal bahwa dia dapat pengalaman yang lebih mulus ketimbang viewer lain: navigasinya lebih enak, layout-nya tidak bikin kepala pusing, dan dia bisa pakai mouse kalau perlu.</p>\n<p>Plus, Hunk memang menjanjikan workflow yang dekat dengan review hasil agent, bukan cuma comparing file.</p>\n<h2 id=\"apa-itu-jj--jujutsu-di-konteks-ini\">Apa itu <code>jj</code> / Jujutsu di konteks ini?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#apa-itu-jj--jujutsu-di-konteks-ini\"></a></h2>\n<p><code>jj</code> bukan alias diff tool. <code>jj</code> adalah Jujutsu: sebuah version control system yang punya command seperti <code>jj diff</code>, <code>jj show</code>, <code>jj rebase</code>, dan lain-lain.</p>\n<p>Jujutsu mencoba mengemas ulang UX VCS sambil tetap kompatibel dengan Git. <code>jj diff</code> dan <code>jj show</code> di thread Hunk artinya orang pengen Hunk bisa dipakai sebagai viewer untuk workflow Jujutsu, bukan cuma Git.</p>\n<p>Jadi bagian <code>JJ</code> di note ini bukan sekadar integrasi pager. Dia adalah integrasi antara:</p>\n<ul>\n<li><strong>engine version control</strong> (<code>jj</code>/Jujutsu)</li>\n<li>dan <strong>review UI diff</strong> (Hunk)</li>\n</ul>\n<p>Itu penting supaya lo ngerti kenapa thread Hunk ada banyak referensi ke <code>jj</code>.</p>\n<h2 id=\"use-case-paling-cocok-buat-apa\">Use case paling cocok buat apa?<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#use-case-paling-cocok-buat-apa\"></a></h2>\n<p>Use case Hunk yang paling pas menurut gue:</p>\n<ol>\n<li>\n<p><strong>Review changeset lokal di repo Git</strong></p>\n<ul>\n<li><code>hunk diff</code> untuk working tree</li>\n<li><code>hunk show</code> untuk commit</li>\n<li>cocok buat pre-commit review dan melihat perubahan multi-file</li>\n</ul>\n</li>\n<li>\n<p><strong>Review live saat coding</strong></p>\n<ul>\n<li><code>hunk diff --watch</code></li>\n<li>Hunk auto-reload saat file berubah</li>\n<li>pas banget buat buka editor di satu terminal dan review di terminal lain</li>\n</ul>\n</li>\n<li>\n<p><strong>Review patch atau stdin diff</strong></p>\n<ul>\n<li><code>git diff --no-color | hunk patch -</code></li>\n<li>cocok buat skrip, patch generator, atau output tool lain</li>\n</ul>\n</li>\n<li>\n<p><strong>Review output agent / AI-generated changes</strong></p>\n<ul>\n<li>Hunk punya workflow agent notes</li>\n<li>bisa pakai <code>hunk diff</code> sambil agent bantu anotasi</li>\n<li>ini sesuai positioning resmi mereka</li>\n</ul>\n</li>\n</ol>\n<h2 id=\"cara-pakainya\">Cara pakainya<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#cara-pakainya\"></a></h2>\n<h3 id=\"dasar\">Dasar<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#dasar\"></a></h3>\n<p>Install:</p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">npm</span> i -g hunkdiff\n<span class=\"token comment\"># atau</span>\nbrew <span class=\"token function\">install</span> modem-dev/tap/hunk\n</code></pre>\n<p>Jalankan:</p>\n<pre class=\"language-bash\"><code class=\"language-bash\">hunk\nhunk --version\n</code></pre>\n<h3 id=\"review-repo-git\">Review repo Git<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#review-repo-git\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\">hunk <span class=\"token function\">diff</span>\nhunk show\nhunk show HEAD~1\n</code></pre>\n<h3 id=\"live-watch-mode\">Live watch mode<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#live-watch-mode\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\">hunk <span class=\"token function\">diff</span> --watch\nhunk <span class=\"token function\">diff</span> before.ts after.ts --watch\n</code></pre>\n<h3 id=\"review-patch-dari-pipe\">Review patch dari pipe<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#review-patch-dari-pipe\"></a></h3>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">git</span> <span class=\"token function\">diff</span> --no-color <span class=\"token operator\">|</span> hunk patch -\n</code></pre>\n<h3 id=\"integrasi-git-pager\">Integrasi Git pager<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#integrasi-git-pager\"></a></h3>\n<p>Kalau mau pakai Hunk sebagai pager Git:</p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">git</span> config --global core.pager <span class=\"token string\">\"hunk pager\"</span>\n</code></pre>\n<p>Atau alias opt-in:</p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">git</span> config --global alias.hdiff <span class=\"token string\">\"-c core.pager=<span class=\"token entity\" title=\"\\&#x22;\">\\\"</span>hunk pager<span class=\"token entity\" title=\"\\&#x22;\">\\\"</span> diff\"</span>\n<span class=\"token function\">git</span> config --global alias.hshow <span class=\"token string\">\"-c core.pager=<span class=\"token entity\" title=\"\\&#x22;\">\\\"</span>hunk pager<span class=\"token entity\" title=\"\\&#x22;\">\\\"</span> show\"</span>\n</code></pre>\n<p>Lalu pakai:</p>\n<pre class=\"language-bash\"><code class=\"language-bash\"><span class=\"token function\">git</span> hdiff\n<span class=\"token function\">git</span> hshow\n</code></pre>\n<h3 id=\"integrasi-jujutsu-jj\">Integrasi Jujutsu (JJ)<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#integrasi-jujutsu-jj\"></a></h3>\n<p>Hunk bisa auto-detect JJ workspace dan support <code>hunk diff [revset]</code> / <code>hunk show [revset]</code>.\nKalau mau paksa VCS:</p>\n<pre class=\"language-toml\"><code class=\"language-toml\"><span class=\"token comment\"># ~/.config/hunk/config.toml</span>\n<span class=\"token key property\">vcs</span> <span class=\"token punctuation\">=</span> <span class=\"token string\">\"jj\"</span>\n</code></pre>\n<p>Untuk JJ pager:</p>\n<pre class=\"language-toml\"><code class=\"language-toml\"><span class=\"token punctuation\">[</span><span class=\"token table class-name\">ui</span><span class=\"token punctuation\">]</span>\n<span class=\"token key property\">pager</span> <span class=\"token punctuation\">=</span> <span class=\"token punctuation\">[</span><span class=\"token string\">\"hunk\"</span><span class=\"token punctuation\">,</span> <span class=\"token string\">\"pager\"</span><span class=\"token punctuation\">]</span>\n<span class=\"token key property\">diff-formatter</span> <span class=\"token punctuation\">=</span> <span class=\"token string\">\":git\"</span>\n</code></pre>\n<h2 id=\"limitasi-dibanding-tool-diff-lain\">Limitasi dibanding tool diff lain<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#limitasi-dibanding-tool-diff-lain\"></a></h2>\n<p>Hunk punya keunggulan di sisi review-first UI, tapi bukan pakar structural diff.\nKalau lo butuh AST-aware diff atau syntax-aware structural comparison, tool lain seperti <code>difftastic</code> masih lebih tepat.</p>\n<p>Beberapa limitasi yang gue tangkap:</p>\n<ul>\n<li><strong>bukan structural diff tool</strong> seperti difftastic</li>\n<li><strong>UI review lebih penting daripada algoritma diff</strong></li>\n<li>integrasi JJ dulu sempat agak kurang jelas, meski sekarang dokumentasinya sudah mendingan</li>\n</ul>\n<h2 id=\"kesimpulan\">Kesimpulan<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#kesimpulan\"></a></h2>\n<p>Hunk paling kuat kalau lo mau memposisikan changeset sebagai objek review, bukan cuma text patch.\nKalau workflow lo butuh:</p>\n<ul>\n<li>navigasi file cepat,</li>\n<li>preview diff multi-file,</li>\n<li>live watch mode,</li>\n<li>keyboard + mouse terminal UI,</li>\n<li>dan review hasil AI/agent,</li>\n</ul>\n<p>maka Hunk bisa jadi tool yang benar-benar menggantikan <code>git diff</code> biasa.</p>\n<p>Kalau lo cuma butuh structural syntax diff, mungkin Hunk bukan tool utama.</p>\n<hr>\n<h2 id=\"tags\">Tags<a aria-hidden=\"true\" class=\"anchor-heading icon-link\" href=\"#tags\"></a></h2>\n<ol>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">notes (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">prompt-engineering (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">devtools (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">diff (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">terminal (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">jj (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">jujutsu (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">x (Private)</a></li>\n<li><a title=\"Private\" href=\"https://wiki.dendron.so/notes/hfyvYGJZQiUwQaaxQO27q.html\" target=\"_blank\" class=\"private\">twitter (Private)</a></li>\n</ol>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/sotoy/notes/daily.journal.2026.05.11\">2026-05-11</a></li>\n</ul>","noteIndex":{"id":"root","title":"Hello and Welcome! 👋","desc":"","updated":1778468084907,"created":1724251163400,"tags":["x","twitter"],"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"fbada016be66dbd4790f7e49ede05b67","links":[{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.x","alias":"x","xvault":false,"to":{"fname":"tags.x"}},{"type":"frontmatterTag","from":{"fname":"root","id":"root","vaultName":"vault"},"value":"tags.twitter","alias":"twitter","xvault":false,"to":{"fname":"tags.twitter"}}],"anchors":{"find-more":{"type":"header","text":"Find More","value":"find-more","line":23,"column":0,"depth":2}},"children":["book-summaries","daily","handbook","notes","tags","til","zettel"],"parent":null,"data":{},"body":"\nWelcome to the homepage! I use Dendron to store and organize notes, ideas, and experiments I’m working on. Here are the main sections you’ll find on this site:\n\n1. **Learning Notes** — Practical notes on programming, recent technologies, and productivity tips.\n2. **Personal Projects** — Summaries of projects, experiments, and outcomes I’m working on or have completed.\n3. **Writings & Opinions** — Casual articles and reflections about technology, daily life, and other interesting topics.\n\nI’m constantly experimenting and learning. I hope the content here helps you as a reference, a starting point for discussion, or just light reading.\n\n> Why Dendron?\n>\nDendron helps keep notes organized. Its \"seed\" and \"vault\" concepts make it easy to structure content and find what you need.\n\n## Find More\n\nIf you want to learn more or connect, check these links:\n\n- [Homepage (Dendron)](https://zeihanaulia.github.io/sotoy/)\n- [My GitHub](https://github.com/zeihanaulia)\n- [My Twitter 