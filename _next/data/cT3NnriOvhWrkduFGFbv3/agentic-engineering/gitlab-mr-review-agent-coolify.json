{"pageProps":{"note":{"id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","title":"GitLab MR Review Agent di Coolify","desc":"Desain self-hosted GitLab MR review agent di Coolify dengan webhook trigger comment, worker terisolasi, dan structured report.","updated":1778003052323,"created":1777998924151,"tags":["notes","agentic-engineering","gitlab","coolify","mr-review"],"custom":{},"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","type":"note","vault":{"fsPath":"vault"},"contentHash":"280ae8904eaf3f745dda1f24e1d16e6b","links":[{"type":"frontmatterTag","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"tags.notes","alias":"notes","xvault":false,"to":{"fname":"tags.notes"}},{"type":"frontmatterTag","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"tags.agentic-engineering","alias":"agentic-engineering","xvault":false,"to":{"fname":"tags.agentic-engineering"}},{"type":"frontmatterTag","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"tags.gitlab","alias":"gitlab","xvault":false,"to":{"fname":"tags.gitlab"}},{"type":"frontmatterTag","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"tags.coolify","alias":"coolify","xvault":false,"to":{"fname":"tags.coolify"}},{"type":"frontmatterTag","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"tags.mr-review","alias":"mr-review","xvault":false,"to":{"fname":"tags.mr-review"}},{"type":"wiki","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"notes.agentic-engineering.cloud-agent.handson.gitlab-mr-comment-formatting","position":{"start":{"line":317,"column":3,"offset":6862},"end":{"line":317,"column":81,"offset":6940},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.cloud-agent.handson.gitlab-mr-comment-formatting"}},{"type":"wiki","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"notes.agentic-engineering.cloud-agent.handson.references","position":{"start":{"line":318,"column":3,"offset":6943},"end":{"line":318,"column":63,"offset":7003},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.cloud-agent.handson.references"}},{"type":"wiki","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"notes.agentic-engineering.how-i-use-ai-to-code","position":{"start":{"line":319,"column":3,"offset":7006},"end":{"line":319,"column":53,"offset":7056},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"notes.agentic-engineering.how-i-use-ai-to-code"}},{"type":"wiki","from":{"fname":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","id":"notes.agentic-engineering.gitlab-mr-review-agent-coolify","vaultName":"vault"},"value":"zettel.moc.agentic-engineering","position":{"start":{"line":320,"column":3,"offset":7059},"end":{"line":320,"column":37,"offset":7093},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"zettel.moc.agentic-engineering"}},{"from":{"fname":"zettel.literature.how-i-use-ai-to-code","id":"zettel.literature.how-i-use-ai-to-code","vaultName":"vault"},"type":"backlink","position":{"start":{"line":32,"column":3,"offset":1865},"end":{"line":32,"col